{
  "manifest_version": 3,
  "name": "FluentBitwarden",
  "version": "0.5.0",
  "description": "Browser integration for FluentBitwarden.",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
