<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentBitwarden.Views.Passkeys.PasskeySelectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentBitwarden.Controls.Vault"
    xmlns:controls1="using:FluentBitwarden.Controls"
    xmlns:converters="using:FluentBitwarden.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BitwardenApi.Vault.Items.Contracts"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToUriConverter x:Name="StringToUriConverter" />
    </Page.Resources>

    <Grid Margin="0" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            HorizontalAlignment="Center"
            FontSize="24"
            FontWeight="SemiBold"
            Text="Select a passkey" />

        <ListView
            x:Name="ListView"
            Grid.Row="1"
            x:Load="{x:Bind ViewModel.HasItems, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ListViewItemPresenter
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    PointerOverBackground="{ThemeResource SystemControlHighlightListLowBrush}"
                                    PressedBackground="{ThemeResource SystemControlHighlightListLowBrush}"
                                    SelectedBackground="{ThemeResource SystemControlHighlightListLowBrush}"
                                    SelectedPointerOverBackground="{ThemeResource SystemControlHighlightListLowBrush}"
                                    SelectedPressedBackground="{ThemeResource SystemControlHighlightListLowBrush}"
                                    SelectionCheckMarkVisualEnabled="False" />

                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Fido2Credential">
                    <Grid
                        Padding="12"
                        VerticalAlignment="Center"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls1:SiteIcon Grid.Column="0" Uri="{x:Bind RpId, Converter={StaticResource StringToUriConverter}}" />

                        <StackPanel Grid.Column="1">
                            <TextBlock
                                Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                                Text="{x:Bind UserName}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Opacity="0.72"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind UserDisplayName}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Opacity="0.72"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind RpName}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Empty state  -->
        <StackPanel
            x:Name="EmptyStatePanel"
            Grid.Row="1"
            Margin="0,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            x:Load="{x:Bind ViewModel.HasNoItems, Mode=OneWay}"
            Spacing="8">

            <SymbolIcon Opacity="0.65" Symbol="Important" />

            <TextBlock
                Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                Text="No passkeys found"
                TextAlignment="Center" />

            <TextBlock
                Opacity="0.70"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="There are no FIDO2 credentials in this vault"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
