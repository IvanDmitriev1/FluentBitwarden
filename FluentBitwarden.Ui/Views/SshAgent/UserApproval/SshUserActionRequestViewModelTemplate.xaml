<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="FluentBitwarden.Views.SshAgent.UserApproval.SshUserActionRequestViewModelTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FluentBitwarden.Contracts.Modules.Ssh">

    <Style x:Key="MutedTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LabelTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <DataTemplate x:Name="SshUserActionRequestViewModelTemplateKey" x:DataType="models:SshUserActionRequest">
        <Grid
            Width="440"
            MaxWidth="440"
            RowSpacing="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <TextBlock
                Grid.Row="0"
                Style="{StaticResource MutedTextBlockStyle}"
                Text="An SSH client wants to use one of your keys to sign an authentication request." />

            <!--  Key card  -->
            <Border
                Grid.Row="2"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">

                <StackPanel Spacing="14">

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="48"
                            Height="48"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="12">

                            <FontIcon
                                FontSize="24"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Glyph="&#xE8D7;" />
                        </Border>

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                            Text="{x:Bind KeyName}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="Fingerprint:" />

                        <TextBlock
                            Padding="10,8"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind KeyFingerprint}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Footer explanation  -->
            <TextBlock
                Grid.Row="3"
                FontSize="12"
                Style="{StaticResource MutedTextBlockStyle}"
                Text="This approval is valid for this request only." />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
