<?xml version="1.0" encoding="utf-8" ?>
<lifecycle:LifecyclePage
    x:Class="FluentBitwarden.Views.Vault.Browse.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attachedProperties="using:FluentBitwarden.Shared.AttachedProperties"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lifecycle="using:FluentBitwarden.Shared.Navigation.Lifecycle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FluentBitwarden.Views.Vault.Browse.Models"
    xmlns:sharedControls="using:FluentBitwarden.Shared.Controls"
    xmlns:templates="using:FluentBitwarden.Views.Vault.Browse.Templates"
    xmlns:vaultControls="using:FluentBitwarden.Views.Vault.Browse.Controls"
    xmlns:workspace="using:FluentBitwarden.Contracts.Modules.Vault.Workspace"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <lifecycle:LifecyclePage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Vault/Browse/Templates/CipherListViewItemTemplate.xaml" />
                <templates:CipherDetailTemplates />
                <templates:CipherListItemDataTemplate />
            </ResourceDictionary.MergedDictionaries>

            <models:CipherTypeOptionOptionConverter x:Key="CipherTypeOptionConverter" />
        </ResourceDictionary>
    </lifecycle:LifecyclePage.Resources>

    <SplitView
        x:Name="MainSplitView"
        DisplayMode="Inline"
        IsPaneOpen="True"
        OpenPaneLength="380"
        PaneBackground="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">

        <SplitView.Pane>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <sharedControls:SearchFilterBar
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="16,16,16,8"
                    IsSearchOpen="{x:Bind ViewModel.IsSearchFieldOpen, Mode=TwoWay}"
                    SearchText="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <sharedControls:SearchFilterBar.FilterContent>
                        <ComboBox
                            ItemTemplate="{StaticResource OptionItemComboBoxItemTemplate}"
                            ItemsSource="{x:Bind models:CipherTypeOption.All}"
                            PlaceholderText="Filter by type"
                            SelectedItem="{x:Bind ViewModel.SelectedCipherType, Mode=TwoWay, Converter={StaticResource CipherTypeOptionConverter}}" />
                    </sharedControls:SearchFilterBar.FilterContent>
                    <sharedControls:SearchFilterBar.SortFlyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">

                            <sharedControls:RadioMenuFlyoutItem
                                SelectedValue="{x:Bind ViewModel.CipherSortField, Mode=TwoWay}"
                                Text="Title"
                                Value="{x:Bind workspace:VaultCipherSortField.Name}" />

                            <sharedControls:RadioMenuFlyoutItem
                                SelectedValue="{x:Bind ViewModel.CipherSortField, Mode=TwoWay}"
                                Text="Date created"
                                Value="{x:Bind workspace:VaultCipherSortField.CreationDate}" />

                            <sharedControls:RadioMenuFlyoutItem
                                SelectedValue="{x:Bind ViewModel.CipherSortField, Mode=TwoWay}"
                                Text="Date modified"
                                Value="{x:Bind workspace:VaultCipherSortField.RevisionDate}" />

                            <MenuFlyoutSeparator />

                            <sharedControls:RadioMenuFlyoutItem
                                SelectedValue="{x:Bind ViewModel.CipherSortDirection, Mode=TwoWay}"
                                Text="Newest first"
                                Value="{x:Bind workspace:VaultCipherSortDirection.Ascending}" />

                            <sharedControls:RadioMenuFlyoutItem
                                SelectedValue="{x:Bind ViewModel.CipherSortDirection, Mode=TwoWay}"
                                Text="Oldest first"
                                Value="{x:Bind workspace:VaultCipherSortDirection.Descending}" />

                        </MenuFlyout>
                    </sharedControls:SearchFilterBar.SortFlyout>
                </sharedControls:SearchFilterBar>

                <ListView
                    x:Name="VaultCipherList"
                    Grid.Row="1"
                    Grid.Column="0"
                    attachedProperties:VaultListSelectionBehavior.BringToView="{x:Bind ViewModel.SelectedCipher, Mode=TwoWay}"
                    IsItemClickEnabled="False"
                    ItemContainerStyle="{StaticResource VaultCipherListViewItemStyle}"
                    ItemTemplate="{StaticResource CipherListItemDataTemplate}"
                    ItemsSource="{x:Bind ViewModel.FilteredCiphers, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedCipher, Mode=TwoWay}"
                    SelectionMode="Single"
                    SingleSelectionFollowsFocus="True"
                    TabFocusNavigation="Once" />

                <controls:PropertySizer
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Width="8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Binding="{x:Bind MainSplitView.OpenPaneLength, Mode=TwoWay}"
                    Maximum="600"
                    Minimum="180"
                    Orientation="Vertical" />
            </Grid>

        </SplitView.Pane>

        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind ViewModel.SelectedCipher, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">

            <StackPanel
                x:Name="CipherDetailsStackPanel"
                Padding="20"
                x:Load="{x:Bind ViewModel.SelectedCipher, Mode=OneWay, Converter={StaticResource NullToBoolConverter}}"
                Spacing="20">
                <StackPanel
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="24">
                    <vaultControls:SiteIcon
                        FallbackGlyph="{x:Bind models:CipherExtensions.GetDefaultGlyph(ViewModel.SelectedCipher), Mode=OneWay}"
                        Size="36"
                        Uri="{x:Bind models:CipherExtensions.GetDefaultSiteIconUri(ViewModel.SelectedCipher), Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.SelectedCipher.Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <ContentControl
                    HorizontalContentAlignment="Stretch"
                    Content="{x:Bind ViewModel.SelectedCipher, Mode=OneWay}"
                    ContentTemplateSelector="{StaticResource VaultCipherTemplateSelector}" />
            </StackPanel>
        </ScrollViewer>
    </SplitView>
</lifecycle:LifecyclePage>
