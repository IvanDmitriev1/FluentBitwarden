<?xml version="1.0" encoding="utf-8" ?>
<lifecycle:LifecyclePage
    x:Class="FluentBitwarden.Views.Shell.Offline.OfflinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lifecycle="using:FluentBitwarden.Shared.Navigation.Lifecycle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        MinWidth="420"
        MaxWidth="750"
        Margin="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

        <Border
            Padding="28"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16">
            <Border.Background>
                <SolidColorBrush Opacity="0.92" Color="{ThemeResource CardBackgroundFillColorDefault}" />
            </Border.Background>

            <StackPanel Spacing="18">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="36"
                    Glyph="&#xE839;" />

                <StackPanel Spacing="6">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.RetryCommand}"
                    Content="Retry"
                    Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</lifecycle:LifecyclePage>
