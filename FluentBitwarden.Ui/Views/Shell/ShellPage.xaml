<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentBitwarden.Views.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attachedProperties="using:FluentBitwarden.AttachedProperties"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:templates1="using:FluentBitwarden.Templates"
    xmlns:vault="using:FluentBitwarden.Controls.VaultCiphers"
    attachedProperties:TitlebarProperties.NavigationFrame="{x:Bind ContentFrame}"
    attachedProperties:TitlebarProperties.PaneToggleCommand="{x:Bind PaneToggleCommand}"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <templates1:VaultCipherAutosuggestItemTemplates />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <interactivity:Interaction.Behaviors>
        <behaviors:FocusBehavior>
            <behaviors:FocusTarget Control="{x:Bind VaultCipherSearchBox}" />
        </behaviors:FocusBehavior>
    </interactivity:Interaction.Behaviors>

    <Page.KeyboardAccelerators>
        <attachedProperties:FocusKeyboardAccelerator
            Key="F"
            Modifiers="Control"
            Target="{x:Bind VaultCipherSearchBox}" />
    </Page.KeyboardAccelerators>

    <attachedProperties:TitlebarProperties.Content>
        <vault:VaultCipherSearchBox x:Name="VaultCipherSearchBox" VaultCipherSelectedCommand="{x:Bind VaultCipherSelectedCommand}" />
    </attachedProperties:TitlebarProperties.Content>

    <NavigationView
        x:Name="Nav"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="True"
        ItemInvoked="Nav_OnItemInvoked"
        OpenPaneLength="200"
        PaneDisplayMode="Auto">

        <NavigationView.MenuItems>
            <NavigationViewItem
                Content="Vault"
                Icon="Library"
                Tag="vault" />
            <NavigationViewItem
                Content="Generator"
                Icon="Shuffle"
                Tag="generator" />
            <NavigationViewItem
                Content="Send"
                Icon="Send"
                Tag="send" />
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" Navigated="ContentFrame_OnNavigated" />
    </NavigationView>
</Page>
