<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vaultCiphers="using:FluentBitwarden.Controls.VaultCiphers">

    <Style TargetType="vaultCiphers:VaultCipherUrlField">
        <Setter Property="Label" Value="URI" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="vaultCiphers:VaultCipherUrlField">
                    <vaultCiphers:VaultCipherFieldChrome
                        x:Name="PART_Chrome"
                        ActionText="Copy"
                        Label="{TemplateBinding Label}">

                        <TextBlock
                            x:Name="PART_TextBlock"
                            Style="{StaticResource BodyLargeTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </vaultCiphers:VaultCipherFieldChrome>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
