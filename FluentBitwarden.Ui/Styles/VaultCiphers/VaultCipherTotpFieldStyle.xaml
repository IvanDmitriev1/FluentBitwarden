<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sharedControls="using:FluentBitwarden.Controls.Shared"
    xmlns:vault="using:FluentBitwarden.Controls.VaultCiphers">

    <x:String x:Key="VaultCipherTotpFieldCopyActionText">Copy</x:String>

    <Style TargetType="vault:VaultCipherTotpField">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="vault:VaultCipherTotpField">
                    <vault:VaultCipherFieldChrome
                        x:Name="PART_Chrome"
                        ActionText="{StaticResource VaultCipherTotpFieldCopyActionText}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Label="{TemplateBinding Label}">


                        <StackPanel
                            HorizontalAlignment="Stretch"
                            Orientation="Horizontal"
                            Spacing="6">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyLargeTextBlockStyle}"
                                Text="{TemplateBinding DisplayCode}" />

                            <sharedControls:CountdownRing x:Name="PART_CountdownRing" Grid.Column="1" />
                        </StackPanel>
                    </vault:VaultCipherFieldChrome>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
