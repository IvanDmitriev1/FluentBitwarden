<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vault="using:FluentBitwarden.Controls.Vault">

    <Style TargetType="vault:CipherPasswordField">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="vault:CipherPasswordField">
                    <vault:CipherFieldChrome
                        x:Name="PART_Chrome"
                        ActionText="Copy"
                        Label="{TemplateBinding Label}">

                        <TextBlock
                            Style="{StaticResource BodyLargeTextBlockStyle}"
                            Text="{TemplateBinding DisplayText}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </vault:CipherFieldChrome>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
