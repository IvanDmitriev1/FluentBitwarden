<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="FluentBitwarden.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:FluentBitwarden.Infrastructure.Converters"
    xmlns:sharedTemplates="using:FluentBitwarden.Templates.Shared"
    xmlns:toolkitConverters="using:CommunityToolkit.WinUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/UIStyles.xaml" />

                <sharedTemplates:OptionItemTemplates />
            </ResourceDictionary.MergedDictionaries>

            <toolkitConverters:StringVisibilityConverter x:Key="StringVisibilityConverter" />
            <toolkitConverters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <toolkitConverters:BoolToObjectConverter
                x:Key="InverseBoolToVis"
                FalseValue="Visible"
                TrueValue="Collapsed" />
            <converters:FolderIdSelectedValueConverter x:Key="FolderIdSelectedValueConverter" />
            <toolkitConverters:EmptyObjectToObjectConverter
                x:Key="NullToVisibilityConverter"
                EmptyValue="Collapsed"
                NotEmptyValue="Visible" />
            <toolkitConverters:EmptyObjectToObjectConverter
                x:Key="NullToBoolConverter"
                EmptyValue="False"
                NotEmptyValue="True" />

            <toolkitConverters:EmptyStringToObjectConverter
                x:Key="StringToBoolConverter"
                EmptyValue="False"
                NotEmptyValue="True" />

            <converters:EmptyCollectionToObjectConverter
                x:Key="EmptyCollectionToVisibilityConverter"
                EmptyValue="Collapsed"
                NotEmptyValue="Visible" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
