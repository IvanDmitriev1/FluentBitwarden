<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="FluentBitwarden.Templates.OptionItemTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:FluentBitwarden.Infrastructure.Converters">

    <DataTemplate x:Key="OptionItemComboBoxItemTemplate" x:DataType="converters:IOptionItem">
        <TextBlock
            Text="{x:Bind Title}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
    </DataTemplate>

</ResourceDictionary>
