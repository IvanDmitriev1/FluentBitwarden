<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentBitwarden.Controls.VaultCiphers.VaultCipherSearchBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:templates="using:FluentBitwarden.Templates"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <templates:VaultCipherAutosuggestItemTemplates />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <AutoSuggestBox
        ItemTemplate="{StaticResource VaultCipherAutosuggestItemTemplate}"
        PlaceholderText="Search.."
        QueryIcon="Find"
        QuerySubmitted="AutoSuggestBox_OnQuerySubmitted"
        TextChanged="AutoSuggestBox_OnTextChanged"
        UpdateTextOnSelect="False" />
</UserControl>
