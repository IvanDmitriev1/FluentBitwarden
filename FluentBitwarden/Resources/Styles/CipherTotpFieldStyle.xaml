<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentBitwarden.Resources.Controls">

    <Style TargetType="controls:CipherTotpField">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:CipherTotpField">
                    <controls:CipherFieldChrome
                        x:Name="PART_Chrome"
                        ActionText="Copy"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Label="{TemplateBinding Label}">


                        <StackPanel
                            HorizontalAlignment="Stretch"
                            Orientation="Horizontal"
                            Spacing="6">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyLargeTextBlockStyle}"
                                Text="{TemplateBinding DisplayCode}" />

                            <controls:CountdownRing x:Name="PART_CountdownRing" Grid.Column="1" />
                        </StackPanel>
                    </controls:CipherFieldChrome>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>