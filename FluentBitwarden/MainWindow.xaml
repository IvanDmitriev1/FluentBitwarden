<?xml version="1.0" encoding="utf-8" ?>
<winUiEx:WindowEx
    x:Class="FluentBitwarden.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentBitwarden.Ui.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:notifications="using:FluentBitwarden.Ui.Notifications"
    xmlns:winUiEx="using:WinUIEx"
    Title="FluentBitwarden"
    MinWidth="900"
    MinHeight="600"
    mc:Ignorable="d">

    <winUiEx:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </winUiEx:WindowEx.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="FluentBitwarden"
            Grid.Row="0"
            Height="48">
            <TitleBar.Content>
                <!--<AutoSuggestBox MinWidth="300"
                                MaxWidth="600"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Search"
                                QueryIcon="Find"/>-->
            </TitleBar.Content>
        </TitleBar>

        <controls:NotificationHost
            x:Name="NotificationHost"
            Grid.Row="1"
            Margin="0,12,12,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top" />

        <Frame x:Name="ContentFrame" Grid.Row="1" />
    </Grid>

</winUiEx:WindowEx>
