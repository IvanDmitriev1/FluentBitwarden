<?xml version="1.0" encoding="utf-8" ?>
<winUiEx:SplashScreen
    x:Class="FluentBitwarden.StartupSplashScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winUiEx="using:WinUIEx"
    IsAlwaysOnTop="True"
    mc:Ignorable="d">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Border
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="20">
            <Border.Background>
                <SolidColorBrush Opacity="0.94" Color="{ThemeResource CardBackgroundFillColorDefault}" />
            </Border.Background>

            <StackPanel HorizontalAlignment="Center" Spacing="16">
                <Image
                    Width="72"
                    Height="72"
                    HorizontalAlignment="Center"
                    Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="{x:Bind AppDisplayName}" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Opacity="0.72"
                    Text="Initializing secure device state" />

                <ProgressRing
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    IsActive="True" />
            </StackPanel>
        </Border>
    </Grid>
</winUiEx:SplashScreen>
