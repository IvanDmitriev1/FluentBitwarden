<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="FluentBitwarden.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:FluentBitwarden.Resources.Converters"
    xmlns:converters1="using:FluentBitwarden.UI.Converters"
    xmlns:dialogs="using:FluentBitwarden.Resources.Dialogs"
    xmlns:toolkitConverters="using:CommunityToolkit.WinUI.Converters"
    xmlns:uiStyles="using:FluentBitwarden.UI.Styles">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///UI/Styles/Controls/ValidationFieldStyles.xaml" />
                <ResourceDictionary Source="ms-appx:///Views/Vault/Styles/CipherFieldChromeStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Views/Vault/Styles/CipherTextFieldStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Views/Vault/Styles/CipherPasswordFieldStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Views/Vault/Styles/CipherTotpFieldStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///UI/Styles/Controls/CountdownRingStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///UI/Styles/Controls/SiteIconStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Views/Vault/Styles/CipherListItemStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///UI/Styles/Controls/PasswordBoxExStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///UI/Styles/Controls/TextBoxExStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///UI/Styles/Controls/SearchFilterBarStyle.xaml" />

                <ResourceDictionary Source="ms-appx:///UI/Styles/MyStyles.xaml" />
                <uiStyles:OptionItemTemplates />
                <dialogs:SshUserActionRequestViewModelTemplate />
            </ResourceDictionary.MergedDictionaries>

            <toolkitConverters:StringVisibilityConverter x:Key="StringVisibilityConverter" />
            <toolkitConverters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <toolkitConverters:EmptyObjectToObjectConverter
                x:Key="EmptyObjectToVisibilityConverter"
                EmptyValue="Collapsed"
                NotEmptyValue="Visible" />
            <toolkitConverters:EmptyObjectToObjectConverter
                x:Key="NullToBoolConverter"
                EmptyValue="False"
                NotEmptyValue="True" />

            <toolkitConverters:EmptyStringToObjectConverter
                x:Key="StringToBoolConverter"
                EmptyValue="False"
                NotEmptyValue="True" />

            <converters:StringToUriConverter x:Name="StringToUriConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
