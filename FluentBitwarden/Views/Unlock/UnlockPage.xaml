<?xml version="1.0" encoding="utf-8" ?>
<lifecycle:LifecyclePage
    x:Class="FluentBitwarden.Views.Unlock.UnlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lifecycle="using:FluentBitwarden.UI.Controls.Lifecycle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:unlock1="using:FluentBitwarden.Views.Unlock"
    mc:Ignorable="d">

    <Border
        Width="420"
        Padding="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <Border.Background>
            <SolidColorBrush Opacity="0.92" Color="{ThemeResource CardBackgroundFillColorDefault}" />
        </Border.Background>

        <StackPanel Spacing="22">

            <Image
                Width="85"
                Height="85"
                Source="ms-appx:///Assets/vault-icon.svg"
                Stretch="Uniform" />

            <StackPanel Margin="0,0,0,15" HorizontalAlignment="Center">
                <TextBlock
                    Style="{StaticResource TitleLargeTextBlockStyle}"
                    Text="Your vault is locked"
                    TextAlignment="Center" />
                <TextBlock
                    Opacity="0.8"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.SelectedAccount.Email, Mode=OneWay, FallbackValue=''}"
                    TextAlignment="Center" />
            </StackPanel>

            <unlock1:VaultUnlock Account="{x:Bind ViewModel.SelectedAccount, Mode=OneWay}" ResultCommand="{x:Bind ViewModel.VaultUnlockResultCommand}" />
        </StackPanel>
    </Border>
</lifecycle:LifecyclePage>
