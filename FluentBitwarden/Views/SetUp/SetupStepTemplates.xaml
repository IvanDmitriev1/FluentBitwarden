<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="FluentBitwarden.Views.SetUp.SetupStepTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attached="using:FluentBitwarden.Views.AttachedProperties"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewModels="using:FluentBitwarden.ViewModels" 
    xmlns:setUp="using:FluentBitwarden.ViewModels.SetUp" 
    xmlns:setUp1="using:FluentBitwarden.Views.SetUp">

    <DataTemplate x:Key="PasswordSignInStepTemplate"
                  x:DataType="setUp:PasswordSignInStepViewModel">
        <StackPanel Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock Text="Sign in" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ServerHintText, Mode=OneWay}"
                           Opacity="0.75"
                           TextWrapping="WrapWholeWords" />
            </StackPanel>

            <controls:Segmented
                ItemsSource="{x:Bind Environments, Mode=OneWay}"
                SelectedItem="{x:Bind SelectedEnvironment, Mode=TwoWay}"
                HorizontalAlignment="Stretch">
                <controls:Segmented.ItemTemplate>
                    <DataTemplate x:DataType="setUp:SetupEnvironmentOption">
                        <StackPanel Padding="10,6" Spacing="2">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Opacity="0.65" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </controls:Segmented.ItemTemplate>
            </controls:Segmented>

            <StackPanel Spacing="12">
                <Button Content="Sign in with passkey"
                        Command="{x:Bind ParentViewModel.PasskeySignInCommand, Mode=OneWay}"
                        HorizontalAlignment="Stretch" />

                <TextBlock Text="or" HorizontalAlignment="Center" Opacity="0.55" />

                <TextBox Header="Email"
                         Text="{x:Bind Email, Mode=TwoWay}"
                         PlaceholderText="name@example.com" />

                <PasswordBox Header="Master password"
                             attached:PasswordBoxBinding.BindPassword="True"
                             attached:PasswordBoxBinding.BoundPassword="{x:Bind MasterPassword, Mode=TwoWay}" />

                <Button Style="{StaticResource AccentButtonStyle}"
                        Content="Sign in"
                        Command="{x:Bind ParentViewModel.PasswordSignInCommand, Mode=OneWay}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TwoFactorStepTemplate"
                  x:DataType="setUp:TwoFactorStepViewModel">
        <StackPanel Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock Text="Two-factor authentication"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind PromptText, Mode=OneWay}"
                           Opacity="0.75"
                           TextWrapping="WrapWholeWords" />
                <TextBlock Text="{x:Bind EmailHint, Mode=OneWay}"
                           Opacity="0.6"
                           Visibility="{x:Bind HasEmailHint, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
            </StackPanel>

            <ComboBox Header="Provider"
                      ItemsSource="{x:Bind Providers, Mode=OneWay}"
                      SelectedItem="{x:Bind SelectedProvider, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="setUp:TwoFactorProviderOptionModel">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                                       Opacity="0.65"
                                       FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox Header="Verification code"
                     Text="{x:Bind Code, Mode=TwoWay}"
                     PlaceholderText="123456" />

            <CheckBox Content="Remember this device"
                      IsChecked="{x:Bind RememberThisDevice, Mode=TwoWay}" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Back"
                        Command="{x:Bind ParentViewModel.BackFromTwoFactorCommand, Mode=OneWay}" />
                <Button Style="{StaticResource AccentButtonStyle}"
                        Content="Continue"
                        Command="{x:Bind ParentViewModel.ContinueTwoFactorCommand, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <setUp1:SetupStepTemplateSelector
        x:Key="SetupStepTemplateSelector"
        PasswordSignInTemplate="{StaticResource PasswordSignInStepTemplate}"
        TwoFactorTemplate="{StaticResource TwoFactorStepTemplate}" />
</ResourceDictionary>
