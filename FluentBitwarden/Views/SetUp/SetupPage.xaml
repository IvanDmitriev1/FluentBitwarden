<?xml version="1.0" encoding="utf-8"?>
<ui:CorePage
    x:Class="FluentBitwarden.Views.SetUp.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:FluentBitwarden.Ui.Controls" 
    xmlns:setUp="using:FluentBitwarden.Views.SetUp"
    mc:Ignorable="d">

    <ui:CorePage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <setUp:SetupStepTemplates />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:CorePage.Resources>

    <Grid HorizontalAlignment="Center"
          VerticalAlignment="Center"
          MaxWidth="560"
          MinWidth="320"
          Margin="24">

        <!-- “Card” surface -->
        <Border CornerRadius="16"
            Padding="28"
            BorderThickness="1"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
            <Border.Background>
                <SolidColorBrush Color="{ThemeResource CardBackgroundFillColorDefault}"
                             Opacity="0.92"/>
            </Border.Background>

            <StackPanel Spacing="18">
                <ContentControl Content="{x:Bind ViewModel.CurrentStepViewModel, Mode=OneWay}"
                                ContentTemplateSelector="{StaticResource SetupStepTemplateSelector}" />

                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="28"
                              Height="28"
                              HorizontalAlignment="Center" />

                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Severity="Error"
                         Title="Authentication failed"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </Grid>
</ui:CorePage>
