<?xml version="1.0" encoding="utf-8" ?>
<lifecycle:LifecyclePage
    x:Class="FluentBitwarden.Views.Setup.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lifecycle="using:FluentBitwarden.Shared.Behaviors.Lifecycle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:setup="using:FluentBitwarden.Views.Setup"
    mc:Ignorable="d">

    <lifecycle:LifecyclePage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <setup:SetupStepTemplates />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </lifecycle:LifecyclePage.Resources>

    <Grid
        MinWidth="420"
        MaxWidth="750"
        Margin="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

        <Border
            Padding="28"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16">
            <Border.Background>
                <SolidColorBrush Opacity="0.92" Color="{ThemeResource CardBackgroundFillColorDefault}" />
            </Border.Background>

            <StackPanel Spacing="18">
                <ContentControl
                    HorizontalContentAlignment="Stretch"
                    Content="{x:Bind ViewModel.CurrentState, Mode=OneWay}"
                    ContentTemplateSelector="{StaticResource SetupStepTemplateSelector}" />
            </StackPanel>
        </Border>
    </Grid>
</lifecycle:LifecyclePage>
