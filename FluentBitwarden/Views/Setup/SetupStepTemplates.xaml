<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="FluentBitwarden.Views.Setup.SetupStepTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attachedProperties="using:FluentBitwarden.Ui.AttachedProperties"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:setUp="using:FluentBitwarden.ViewModels.Setup"
    xmlns:setUpViews="using:FluentBitwarden.Views.Setup"
    xmlns:ui="using:FluentBitwarden.Ui.Controls">

    <DataTemplate x:Key="EmailSignInStepTemplate"
                  x:DataType="setUp:EmailSignInStepState">
        <StackPanel Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock Text="Login in to Bitwarden"
                           Style="{ThemeResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Select your environment and continue with your Bitwarden email."
                           TextWrapping="WrapWholeWords"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <controls:Segmented
                ItemsSource="{x:Bind Environments, Mode=OneWay}"
                SelectedItem="{x:Bind SelectedEnvironment, Mode=TwoWay}"
                HorizontalAlignment="Stretch">
                <controls:Segmented.ItemTemplate>
                    <DataTemplate x:DataType="setUp:SetupEnvironmentOption">
                        <StackPanel Padding="10,6" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Subtitle}" Opacity="0.65" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </controls:Segmented.ItemTemplate>
            </controls:Segmented>

            <StackPanel Spacing="12">
                <Button Content="Sign in with passkey"
                        Command="{x:Bind ParentViewModel.PasskeySignInCommand, Mode=OneWay}"
                        HorizontalAlignment="Stretch" />

                <TextBlock Text="or" HorizontalAlignment="Center" Opacity="0.55" />

                <ui:ValidatedField Property="{x:Bind EmailValidation, Mode=OneWay}">
                    <TextBox Header="Email"
                             Text="{x:Bind Email, Mode=TwoWay}"
                             PlaceholderText="name@example.com" />
                </ui:ValidatedField>

                <Button Style="{ThemeResource AccentButtonStyle}"
                        Content="Continue"
                        Command="{x:Bind ContinueCommand, Mode=OneWay}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="PasswordSignInStepTemplate"
                  x:DataType="setUp:PasswordSignInStepState">
        <StackPanel Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock Text="Welcome back"
                           Style="{ThemeResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind Email, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold" />
            </StackPanel>

            <StackPanel Spacing="12">
                <ui:ValidatedField Property="{x:Bind MasterPasswordValidation, Mode=OneWay}">
                    <PasswordBox Header="Master password"
                                 attachedProperties:PasswordBoxBinding.BindPassword="True"
                                 attachedProperties:PasswordBoxBinding.BoundPassword="{x:Bind MasterPassword, Mode=TwoWay}" />
                </ui:ValidatedField>

                <StackPanel Spacing="6" Margin="0, 10, 0, 0">
                    <Button Style="{ThemeResource AccentButtonStyle}"
                            Content="Log in with master password"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ParentViewModel.SignInWithPasswordCommand, Mode=OneWay}" />

                    <Button Content="Back"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind BackToEmailCommand, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TwoFactorStepTemplate"
                  x:DataType="setUp:TwoFactorStepState">
        <StackPanel Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock Text="Two-factor authentication"
                           HorizontalAlignment="Center"
                           Style="{ThemeResource TitleTextBlockStyle}" />

                <TextBlock Text="{x:Bind PromptText, Mode=OneWay}"
                           Opacity="0.75"
                           TextWrapping="WrapWholeWords" />

                <TextBlock Text="{x:Bind EmailHint, Mode=OneWay}"
                           Opacity="0.6"
                           Visibility="{x:Bind HasEmailHint, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
            </StackPanel>

            <ComboBox Header="Provider"
                      ItemsSource="{x:Bind Providers, Mode=OneWay}"
                      SelectedItem="{x:Bind SelectedProvider, Mode=TwoWay}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="setUp:TwoFactorProviderOptionModel">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Title}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Subtitle}"
                                       Opacity="0.65"
                                       FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ui:ValidatedField Property="{x:Bind CodeValidation, Mode=OneWay}">
                <TextBox Header="Verification code"
                         Text="{x:Bind Code, Mode=TwoWay}"
                         PlaceholderText="123456" />
            </ui:ValidatedField>

            <StackPanel Spacing="6" Margin="0, 12, 0, 0">
                <Button Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Content="Continue"
                        Command="{x:Bind ParentViewModel.ContinueTwoFactorCommand, Mode=OneWay}" />
                <Button Content="Back"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind BackFromTwoFactorCommand, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <setUpViews:SetupStepTemplateSelector
        x:Key="SetupStepTemplateSelector"
        EmailSignInTemplate="{StaticResource EmailSignInStepTemplate}"
        PasswordSignInTemplate="{StaticResource PasswordSignInStepTemplate}"
        TwoFactorTemplate="{StaticResource TwoFactorStepTemplate}" />
</ResourceDictionary>
