<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="FluentBitwarden.Views.Setup.SetupStepTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attachedProperties="using:FluentBitwarden.Ui.AttachedProperties"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:setUp="using:FluentBitwarden.ViewModels.Setup"
    xmlns:setUpViews="using:FluentBitwarden.Views.Setup"
    xmlns:ui="using:FluentBitwarden.Ui.Controls">

    <DataTemplate x:Key="EmailSignInStepTemplate" x:DataType="setUp:EmailSignInStepState">
        <StackPanel Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="Login in to Bitwarden" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="Select your environment and continue with your Bitwarden email."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <controls:Segmented
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind Environments, Mode=OneWay}"
                SelectedItem="{x:Bind SelectedEnvironment, Mode=TwoWay}">
                <controls:Segmented.ItemTemplate>
                    <DataTemplate x:DataType="setUp:SetupEnvironmentOption">
                        <StackPanel Padding="10,6" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                            <TextBlock
                                FontSize="12"
                                Opacity="0.65"
                                Text="{x:Bind Subtitle}" />
                        </StackPanel>
                    </DataTemplate>
                </controls:Segmented.ItemTemplate>
            </controls:Segmented>

            <StackPanel Spacing="12">
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind PasskeySignInCommand}"
                    Content="Sign in with passkey" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Opacity="0.55"
                    Text="or" />

                <ui:ValidatedField Property="{x:Bind EmailValidation}">
                    <TextBox
                        Header="Email"
                        PlaceholderText="name@example.com"
                        Text="{x:Bind Email, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </ui:ValidatedField>

                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ContinueCommand}"
                    Content="Continue"
                    Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="PasswordSignInStepTemplate" x:DataType="setUp:PasswordSignInStepState">
        <StackPanel Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="Welcome back" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind Email, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Spacing="12">
                <ui:ValidatedField Property="{x:Bind MasterPasswordValidation}">
                    <PasswordBox
                        attachedProperties:PasswordBoxBinding.BindPassword="True"
                        attachedProperties:PasswordBoxBinding.BoundPassword="{x:Bind MasterPassword, Mode=TwoWay}"
                        Header="Master password" />
                </ui:ValidatedField>

                <StackPanel Margin="0,10,0,0" Spacing="6">
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind SignInWithPasswordCommand}"
                        Content="Log in with master password"
                        Style="{ThemeResource AccentButtonStyle}" />

                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind BackToEmailCommand}"
                        Content="Back" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TwoFactorStepTemplate" x:DataType="setUp:TwoFactorStepState">
        <StackPanel Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="Two-factor authentication" />

                <TextBlock
                    Opacity="0.75"
                    Text="{x:Bind PromptText, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />

                <TextBlock
                    Opacity="0.6"
                    Text="{x:Bind EmailHint, Mode=OneWay}"
                    Visibility="{x:Bind HasEmailHint, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
            </StackPanel>

            <ComboBox
                HorizontalAlignment="Stretch"
                Header="Provider"
                ItemsSource="{x:Bind Providers, Mode=OneWay}"
                SelectedItem="{x:Bind SelectedProvider, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="setUp:TwoFactorProviderOptionModel">
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                            <TextBlock
                                FontSize="12"
                                Opacity="0.65"
                                Text="{x:Bind Subtitle}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ui:ValidatedField Property="{x:Bind CodeValidation}">
                <TextBox
                    Header="Verification code"
                    PlaceholderText="123456"
                    Text="{x:Bind Code, Mode=TwoWay}" />
            </ui:ValidatedField>

            <StackPanel Margin="0,12,0,0" Spacing="6">
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ContinueTwoFactorCommand}"
                    Content="Continue"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind BackFromTwoFactorCommand}"
                    Content="Back" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <setUpViews:SetupStepTemplateSelector
        x:Key="SetupStepTemplateSelector"
        EmailSignInTemplate="{StaticResource EmailSignInStepTemplate}"
        PasswordSignInTemplate="{StaticResource PasswordSignInStepTemplate}"
        TwoFactorTemplate="{StaticResource TwoFactorStepTemplate}" />
</ResourceDictionary>
