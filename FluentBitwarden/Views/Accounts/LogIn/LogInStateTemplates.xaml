<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="FluentBitwarden.Views.Accounts.LogIn.LogInStateTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls1="using:FluentBitwarden.UI.Controls"
    xmlns:local="using:FluentBitwarden.Views.Accounts.LogIn"
    xmlns:models="using:FluentBitwarden.Views.Accounts.LogIn.Models"
    xmlns:states="using:FluentBitwarden.Views.Accounts.LogIn.States">

    <DataTemplate x:Key="LogInEmailStepTemplate" x:DataType="states:LogInEmailStepViewModel">
        <StackPanel Spacing="22">
            <!--  Header  -->
            <StackPanel HorizontalAlignment="Center" Spacing="4">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Login to Bitwarden" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Enter your email and choose the server to continue." />
            </StackPanel>

            <controls1:ValidationField Property="{x:Bind EmailValidation}">
                <controls1:TextBoxEx
                    Command="{x:Bind ContinueCommand}"
                    InputScope="EmailSmtpAddress"
                    PlaceholderText="name@example.com"
                    Text="{x:Bind Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <controls1:TextBoxEx.Header>
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Email" />
                    </controls1:TextBoxEx.Header>
                    <controls1:TextBoxEx.Icon>
                        <FontIcon Glyph="&#xE715;" Style="{StaticResource IconStyle}" />
                    </controls1:TextBoxEx.Icon>
                </controls1:TextBoxEx>
            </controls1:ValidationField>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Server" />
                <controls:Segmented
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind Environments}"
                    SelectedItem="{x:Bind SelectedEnvironment, Mode=TwoWay}">
                    <controls:Segmented.ItemTemplate>
                        <DataTemplate x:DataType="models:LogInEnvironmentOption">
                            <StackPanel Padding="10,6" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.65"
                                    Text="{x:Bind Url}"
                                    Visibility="{x:Bind Url, Converter={StaticResource StringVisibilityConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </controls:Segmented.ItemTemplate>
                </controls:Segmented>
            </StackPanel>

            <StackPanel Spacing="4" Visibility="{x:Bind IsCustomEnvironmentSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <controls1:ValidationField Property="{x:Bind CustomServerUrlValidation}">
                    <controls1:TextBoxEx
                        Command="{x:Bind ContinueCommand}"
                        PlaceholderText="https://vault.example.com"
                        Text="{x:Bind CustomServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <controls1:TextBoxEx.Header>
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Server URL" />
                        </controls1:TextBoxEx.Header>
                        <controls1:TextBoxEx.Icon>
                            <FontIcon Glyph="&#xE909;" Style="{StaticResource IconStyle}" />
                        </controls1:TextBoxEx.Icon>
                    </controls1:TextBoxEx>
                </controls1:ValidationField>

                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Use your self-hosted server URL if you are not using the official cloud."
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <Button
                    Height="36"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ContinueCommand}"
                    Content="Continue"
                    Style="{StaticResource AccentButtonStyle}" />

                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border
                        Height="1"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock Grid.Column="1" Text="or" />

                    <Border
                        Grid.Column="2"
                        Height="1"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </Grid>

                <Button HorizontalAlignment="Stretch" Command="{x:Bind LogInWithPasskeyCommand}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <!--  Fingerprint: E928  -->
                        <FontIcon Glyph="&#xE928;" Style="{StaticResource IconStyle}" />
                        <TextBlock Text="Sign in with passkey" />
                    </StackPanel>
                </Button>

                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind PasskeyErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Visibility="{x:Bind PasskeyErrorMessage, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="LogInPasswordStepTemplate" x:DataType="states:LogInPasswordStepViewModel">
        <StackPanel Spacing="22">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Welcome back!" />

            <local:LoginAccountSummary Email="{x:Bind Email}" ServerDisplayName="{x:Bind ServerDisplayName}" />

            <controls1:ValidationField Property="{x:Bind MasterPasswordValidation}">
                <controls1:PasswordBoxEx
                    x:Name="MasterPasswordBox"
                    ActionButtonCommand="{x:Bind LogInWithPasswordCommand}"
                    ActionButtonCommandParameter="{x:Bind MasterPasswordBox.Password, Mode=OneWay}"
                    Command="{x:Bind LogInWithPasswordCommand}"
                    Header="Master password">
                    <controls1:PasswordBoxEx.ActionButtonContent>
                        <FontIcon
                            FontSize="16"
                            Glyph="&#xE8D7;"
                            Style="{StaticResource IconStyle}" />
                    </controls1:PasswordBoxEx.ActionButtonContent>
                </controls1:PasswordBoxEx>
            </controls1:ValidationField>

            <Button
                Height="36"
                HorizontalAlignment="Stretch"
                Command="{x:Bind LogInWithPasswordCommand}"
                CommandParameter="{x:Bind MasterPasswordBox.Password, Mode=OneWay}"
                Content="Continue"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="LogIn2FStepTemplate" x:DataType="states:LogIn2FStepViewModel">
        <StackPanel Spacing="22">
            <StackPanel Spacing="4">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Two-step verification"
                    TextAlignment="Center" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Enter the verification code to finish login."
                    TextAlignment="Center" />
            </StackPanel>

            <local:LoginAccountSummary Email="{x:Bind Email}" ServerDisplayName="{x:Bind ServerDisplayName}" />


            <StackPanel Spacing="12">
                <ComboBox
                    HorizontalAlignment="Stretch"
                    Header="Method"
                    ItemsSource="{x:Bind Providers, Mode=OneWay}"
                    SelectedItem="{x:Bind SelectedProvider, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:LogIn2FProviderOptionModel">
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.65"
                                    Text="{x:Bind Subtitle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <controls1:ValidationField Property="{x:Bind CodeValidation}">
                    <controls1:TextBoxEx
                        Command="{x:Bind LogIn2FCommand}"
                        Header="Verification code"
                        PlaceholderText="123456"
                        Text="{x:Bind Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls1:ValidationField>
            </StackPanel>

            <Button
                Height="36"
                HorizontalAlignment="Stretch"
                Command="{x:Bind LogIn2FCommand}"
                Content="Continue"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </DataTemplate>

    <local:LogInStateTemplatesSelector
        x:Key="LogInStateTemplatesSelector"
        EmailLogInTemplate="{StaticResource LogInEmailStepTemplate}"
        PasswordLogInTemplate="{StaticResource LogInPasswordStepTemplate}"
        TwoFactorTemplate="{StaticResource LogIn2FStepTemplate}" />

</ResourceDictionary>
