<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentBitwarden.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attachedProperties="using:FluentBitwarden.Ui.AttachedProperties"
    xmlns:controls="using:FluentBitwarden.Ui.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock
                    FontSize="30"
                    FontWeight="SemiBold"
                    Text="Unlock settings" />
                <TextBlock Opacity="0.75" Text="{x:Bind ViewModel.SessionDisplay.Email, Mode=OneWay}" />
            </StackPanel>

            <ProgressRing
                Grid.Column="1"
                Width="28"
                Height="28"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.BackCommand, Mode=OneWay}"
                Content="Back" />
        </Grid>

        <StackPanel Grid.Row="2" Spacing="16">
            <Border
                Padding="20"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="12">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Windows Hello" />
                    <TextBlock Opacity="0.8" Text="{x:Bind ViewModel.WindowsHelloStatusText, Mode=OneWay}" />

                    <Button
                        Command="{x:Bind ViewModel.EnableWindowsHelloCommand, Mode=OneWay}"
                        Content="Enable Windows Hello"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.CanEnableWindowsHello, Converter={StaticResource BoolToVis}, Mode=OneWay}" />

                    <Button
                        Command="{x:Bind ViewModel.DisableWindowsHelloCommand, Mode=OneWay}"
                        Content="Disable Windows Hello"
                        Visibility="{x:Bind ViewModel.IsWindowsHelloConfigured, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="12">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="PIN" />
                    <TextBlock Opacity="0.8" Text="{x:Bind ViewModel.PinStatusText, Mode=OneWay}" />

                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.CanEnablePin, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                        <controls:ValidatedField Property="{x:Bind ViewModel.PinValidation, Mode=OneWay}">
                            <PasswordBox
                                attachedProperties:PasswordBoxBinding.BindPassword="True"
                                attachedProperties:PasswordBoxBinding.BoundPassword="{x:Bind ViewModel.Pin, Mode=TwoWay}"
                                Header="New PIN" />
                        </controls:ValidatedField>

                        <controls:ValidatedField Property="{x:Bind ViewModel.ConfirmPinValidation, Mode=OneWay}">
                            <PasswordBox
                                attachedProperties:PasswordBoxBinding.BindPassword="True"
                                attachedProperties:PasswordBoxBinding.BoundPassword="{x:Bind ViewModel.ConfirmPin, Mode=TwoWay}"
                                Header="Confirm PIN" />
                        </controls:ValidatedField>

                        <Button
                            Command="{x:Bind ViewModel.EnablePinCommand, Mode=OneWay}"
                            Content="Enable PIN"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>

                    <Button
                        Command="{x:Bind ViewModel.DisablePinCommand, Mode=OneWay}"
                        Content="Disable PIN"
                        Visibility="{x:Bind ViewModel.IsPinConfigured, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
