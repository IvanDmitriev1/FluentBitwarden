<?xml version="1.0" encoding="utf-8"?>
<controls:CorePage
    x:Class="FluentBitwarden.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:attachedProperties="using:FluentBitwarden.Ui.AttachedProperties"
    xmlns:controls="using:FluentBitwarden.Ui.Controls"
    mc:Ignorable="d">

    <Grid Margin="24"
          RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Spacing="4">
                <TextBlock Text="Unlock settings"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.SessionDisplay.Email, Mode=OneWay}"
                           Opacity="0.75" />
            </StackPanel>

            <ProgressRing Grid.Column="1"
                          Width="28"
                          Height="28"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          VerticalAlignment="Center" />

            <Button Grid.Column="2"
                    Content="Back"
                    Command="{x:Bind ViewModel.BackCommand, Mode=OneWay}"
                    VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="2"
                    Spacing="16">
            <Border Padding="20"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Windows Hello"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.WindowsHelloStatusText, Mode=OneWay}"
                               Opacity="0.8" />

                    <Button Content="Enable Windows Hello"
                            Command="{x:Bind ViewModel.EnableWindowsHelloCommand, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CanEnableWindowsHello, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />

                    <Button Content="Disable Windows Hello"
                            Command="{x:Bind ViewModel.DisableWindowsHelloCommand, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsWindowsHelloConfigured, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Padding="20"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="PIN"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.PinStatusText, Mode=OneWay}"
                               Opacity="0.8" />

                    <StackPanel Spacing="12"
                                Visibility="{x:Bind ViewModel.CanEnablePin, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                        <controls:ValidatedField Property="{x:Bind ViewModel.PinValidation, Mode=OneWay}">
                            <PasswordBox Header="New PIN"
                                         attachedProperties:PasswordBoxBinding.BindPassword="True"
                                         attachedProperties:PasswordBoxBinding.BoundPassword="{x:Bind ViewModel.Pin, Mode=TwoWay}" />
                        </controls:ValidatedField>

                        <controls:ValidatedField Property="{x:Bind ViewModel.ConfirmPinValidation, Mode=OneWay}">
                            <PasswordBox Header="Confirm PIN"
                                         attachedProperties:PasswordBoxBinding.BindPassword="True"
                                         attachedProperties:PasswordBoxBinding.BoundPassword="{x:Bind ViewModel.ConfirmPin, Mode=TwoWay}" />
                        </controls:ValidatedField>

                        <Button Content="Enable PIN"
                                Command="{x:Bind ViewModel.EnablePinCommand, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>

                    <Button Content="Disable PIN"
                            Command="{x:Bind ViewModel.DisablePinCommand, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsPinConfigured, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</controls:CorePage>
