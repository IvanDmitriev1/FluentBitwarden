<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="FluentBitwarden.Views.Vault.Templates.CipherListViewItemTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BitwardenApi.Modules.Vault.Models"
    xmlns:templates="using:FluentBitwarden.Views.Vault.Templates">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="VaultCipherItemSelectedBrush" Color="#FF3774E3" />
            <SolidColorBrush x:Key="VaultCipherItemSelectedPointerOverBrush" Color="#FF3F7CEC" />
            <SolidColorBrush x:Key="VaultCipherItemSelectedPressedBrush" Color="#FF2F68CF" />
            <SolidColorBrush x:Key="VaultCipherItemSelectedForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="VaultCipherItemSelectedBorderBrush" Color="#FF3774E3" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="VaultCipherItemSelectedBrush" Color="#FF3774E3" />
            <SolidColorBrush x:Key="VaultCipherItemSelectedPointerOverBrush" Color="#FF3F7CEC" />
            <SolidColorBrush x:Key="VaultCipherItemSelectedPressedBrush" Color="#FF2F68CF" />
            <SolidColorBrush x:Key="VaultCipherItemSelectedForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="VaultCipherItemSelectedBorderBrush" Color="#FF3774E3" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <DataTemplate x:Key="LoginCipherListItemTemplate" x:DataType="models:LoginCipher">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <FontIcon
                VerticalAlignment="Center"
                FontSize="18"
                Glyph="&#xE72E;" />

            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Username}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SecureNoteCipherListItemTemplate" x:DataType="models:SecureNoteCipher">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <FontIcon
                VerticalAlignment="Center"
                FontSize="18"
                Glyph="&#xE70B;" />

            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Text="{x:Bind Notes}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="CardCipherListItemTemplate" x:DataType="models:CardCipher">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <FontIcon
                VerticalAlignment="Center"
                FontSize="18"
                Glyph="&#xE8C7;" />

            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Brand}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="IdentityCipherListItemTemplate" x:DataType="models:IdentityCipher">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <FontIcon
                VerticalAlignment="Center"
                FontSize="18"
                Glyph="&#xE77B;" />

            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Email}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SshKeyCipherListItemTemplate" x:DataType="models:SshKeyCipher">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <FontIcon
                VerticalAlignment="Center"
                FontSize="18"
                Glyph="&#xE756;" />

            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind KeyFingerprint}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </DataTemplate>


    <Style x:Key="VaultCipherListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ListViewItemPresenter
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Background="Transparent"
                        CheckHintBrush="Transparent"
                        Content="{TemplateBinding Content}"
                        ContentMargin="{TemplateBinding Padding}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        CornerRadius="6"
                        FocusBorderBrush="Transparent"
                        FocusSecondaryBorderBrush="Transparent"
                        PointerOverBackground="{ThemeResource SubtleFillColorSecondaryBrush}"
                        PressedBackground="{ThemeResource SubtleFillColorTertiaryBrush}"
                        ReorderHintOffset="0"
                        SelectedBackground="{ThemeResource VaultCipherItemSelectedBrush}"
                        SelectedBorderBrush="{ThemeResource VaultCipherItemSelectedBorderBrush}"
                        SelectedBorderThickness="0"
                        SelectedForeground="{ThemeResource VaultCipherItemSelectedForegroundBrush}"
                        SelectedInnerBorderBrush="{ThemeResource VaultCipherItemSelectedBorderBrush}"
                        SelectedPointerOverBackground="{ThemeResource VaultCipherItemSelectedPointerOverBrush}"
                        SelectedPressedBackground="{ThemeResource VaultCipherItemSelectedPressedBrush}"
                        SelectedPressedBorderBrush="{ThemeResource VaultCipherItemSelectedBorderBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <templates:CipherListTemplateSelector
        x:Key="CipherListTemplateSelector"
        CardTemplate="{StaticResource CardCipherListItemTemplate}"
        IdentityTemplate="{StaticResource IdentityCipherListItemTemplate}"
        LoginTemplate="{StaticResource LoginCipherListItemTemplate}"
        SecureNoteTemplate="{StaticResource SecureNoteCipherListItemTemplate}"
        SshKeyTemplate="{StaticResource SshKeyCipherListItemTemplate}" />

</ResourceDictionary>