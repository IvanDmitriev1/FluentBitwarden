<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="FluentBitwarden.Views.Vault.Templates.CipherListItemDataTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentBitwarden.UI.Controls"
    xmlns:extensions="using:FluentBitwarden.Infrastructure.Extensions"
    xmlns:models="using:BitwardenApi.Models">

    <x:Double x:Key="CipherListItemDataTemplateIconSize">22</x:Double>

    <DataTemplate x:Key="CipherListItemDataTemplate" x:DataType="models:VaultCipher">
        <Grid VerticalAlignment="Center" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:SiteIcon
                Grid.Column="0"
                FallbackGlyph="{x:Bind extensions:CipherExtensions.GetDefaultGlyph((models:VaultCipher))}"
                Size="{StaticResource CipherListItemDataTemplateIconSize}"
                Uri="{x:Bind extensions:CipherExtensions.GetDefaultSiteIconUri((models:VaultCipher))}" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock
                    x:Name="SubTitle"
                    x:Load="{x:Bind extensions:CipherExtensions.HasSubtitle((models:VaultCipher))}"
                    Opacity="0.72"
                    Text="{x:Bind extensions:CipherExtensions.GetSubtitle((models:VaultCipher))}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>