<?xml version="1.0" encoding="utf-8" ?>
<lifecycle:LifecyclePage
    x:Class="FluentBitwarden.Views.Vault.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls1="using:FluentBitwarden.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lifecycle="using:FluentBitwarden.UI.Controls.Lifecycle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FluentBitwarden.Views.Vault.Models"
    xmlns:models1="using:BitwardenApi.Models"
    xmlns:models2="using:FluentBitwarden.Modules.Vault.Models"
    xmlns:templates="using:FluentBitwarden.Views.Vault.Templates"
    xmlns:vaultControls="using:FluentBitwarden.Views.Vault.Controls"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <lifecycle:LifecyclePage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Vault/Templates/CipherListViewItemTemplate.xaml" />
                <templates:CipherDetailTemplates />
            </ResourceDictionary.MergedDictionaries>

            <models:CipherTypeOptionOptionConverter x:Key="CipherTypeOptionConverter" />
        </ResourceDictionary>
    </lifecycle:LifecyclePage.Resources>

    <SplitView
        x:Name="MainSplitView"
        DisplayMode="Inline"
        IsPaneOpen="True"
        OpenPaneLength="380"
        PaneBackground="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">

        <SplitView.Pane>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <controls1:SearchFilterBar
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="16,16,16,8"
                    SearchText="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <controls1:SearchFilterBar.FilterContent>
                        <ComboBox
                            ItemTemplate="{StaticResource OptionItemComboBoxItemTemplate}"
                            ItemsSource="{x:Bind models:CipherTypeOption.All}"
                            PlaceholderText="Filter by type"
                            SelectedItem="{x:Bind ViewModel.SelectedCipherType, Mode=TwoWay, Converter={StaticResource CipherTypeOptionConverter}}" />
                    </controls1:SearchFilterBar.FilterContent>
                    <controls1:SearchFilterBar.SortFlyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">

                            <controls1:RadioMenuFlyoutItem
                                SelectedValue="{x:Bind ViewModel.CipherSortField, Mode=TwoWay}"
                                Text="Title"
                                Value="{x:Bind models2:CipherSortField.Name}" />

                            <controls1:RadioMenuFlyoutItem
                                SelectedValue="{x:Bind ViewModel.CipherSortField, Mode=TwoWay}"
                                Text="Date created"
                                Value="{x:Bind models2:CipherSortField.CreationDate}" />

                            <controls1:RadioMenuFlyoutItem
                                SelectedValue="{x:Bind ViewModel.CipherSortField, Mode=TwoWay}"
                                Text="Date modified"
                                Value="{x:Bind models2:CipherSortField.RevisionDate}" />

                            <MenuFlyoutSeparator />

                            <controls1:RadioMenuFlyoutItem
                                SelectedValue="{x:Bind ViewModel.CipherSortDirection, Mode=TwoWay}"
                                Text="Newest first"
                                Value="{x:Bind models2:CipherSortDirection.Ascending}" />

                            <controls1:RadioMenuFlyoutItem
                                SelectedValue="{x:Bind ViewModel.CipherSortDirection, Mode=TwoWay}"
                                Text="Oldest first"
                                Value="{x:Bind models2:CipherSortDirection.Descending}" />

                        </MenuFlyout>
                    </controls1:SearchFilterBar.SortFlyout>
                </controls1:SearchFilterBar>

                <ListView
                    Grid.Row="1"
                    Grid.Column="0"
                    IsItemClickEnabled="False"
                    ItemContainerStyle="{StaticResource VaultCipherListViewItemStyle}"
                    ItemsSource="{x:Bind ViewModel.FilteredCiphers, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedCipher, Mode=TwoWay}"
                    SelectionMode="Single"
                    SingleSelectionFollowsFocus="True"
                    TabFocusNavigation="Once">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models1:VaultCipher">
                            <vaultControls:CipherListItem VaultCipher="{x:Bind}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <controls:PropertySizer
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Width="8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Binding="{x:Bind MainSplitView.OpenPaneLength, Mode=TwoWay}"
                    Maximum="600"
                    Minimum="180"
                    Orientation="Vertical" />
            </Grid>

        </SplitView.Pane>

        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind ViewModel.SelectedCipher, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}">

            <StackPanel Padding="20" Spacing="20">
                <vaultControls:CipherDetailsHeader VaultCipher="{x:Bind ViewModel.SelectedCipher, Mode=OneWay}" />

                <ContentControl
                    HorizontalContentAlignment="Stretch"
                    Content="{x:Bind ViewModel.SelectedCipher, Mode=OneWay}"
                    ContentTemplateSelector="{StaticResource CipherDetailsTemplateSelector}" />
            </StackPanel>
        </ScrollViewer>
    </SplitView>
</lifecycle:LifecyclePage>
