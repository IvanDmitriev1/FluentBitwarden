<?xml version="1.0" encoding="utf-8"?>
<ui:CorePage
    x:Class="FluentBitwarden.Views.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:FluentBitwarden.Ui.Controls"
    xmlns:viewModels="using:FluentBitwarden.ViewModels"
    mc:Ignorable="d">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Spacing="4">
                <TextBlock Text="Vault"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock Text="Items are loaded from the local encrypted cache and decrypted in memory."
                           Opacity="0.7" />
            </StackPanel>

            <ProgressRing Grid.Column="1"
                          Width="28"
                          Height="28"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          VerticalAlignment="Center" />

            <Button Grid.Column="2"
                    Content="Settings"
                    Command="{x:Bind ViewModel.OpenSettingsCommand, Mode=OneWay}"
                    VerticalAlignment="Center" />

            <Button Grid.Column="3"
                    Content="Lock"
                    Command="{x:Bind ViewModel.LockCommand, Mode=OneWay}"
                    VerticalAlignment="Center" />

            <Button Grid.Column="4"
                    Content="Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"
                    VerticalAlignment="Center" />

            <Button Grid.Column="5"
                    Content="Log out"
                    Command="{x:Bind ViewModel.LogoutCommand, Mode=OneWay}"
                    VerticalAlignment="Center" />
        </Grid>

        <InfoBar Grid.Row="1"
                 Margin="0,16,0,0"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Severity="Error"
                 Title="Vault load failed"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <ListView Grid.Row="2"
                  Margin="0,16,0,0"
                  ItemsSource="{x:Bind ViewModel.Ciphers, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:VaultCipherRow">
                    <Border Padding="16"
                            Margin="0,0,0,8"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       FontSize="16" />
                            <TextBlock Text="{x:Bind Username, Mode=OneWay}"
                                       Opacity="0.8" />
                            <TextBlock Text="{x:Bind Password, Mode=OneWay}"
                                       FontFamily="Consolas"
                                       TextWrapping="WrapWholeWords" />
                            <TextBlock Text="{x:Bind Urls, Mode=OneWay}"
                                       Opacity="0.65"
                                       TextWrapping="WrapWholeWords" />
                            <InfoBar IsOpen="{x:Bind HasDecryptionError, Mode=OneWay}"
                                     Severity="Warning"
                                     Title="Partial item"
                                     Message="This item could not be fully decrypted with the currently available keys." />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ui:CorePage>
