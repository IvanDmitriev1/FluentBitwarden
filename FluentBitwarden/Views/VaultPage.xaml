<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentBitwarden.Views.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:FluentBitwarden.Ui.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:FluentBitwarden.ViewModels"
    mc:Ignorable="d">

    <interactivity:Interaction.Behaviors>
        <behaviors:PageLifecycleBehavior />
    </interactivity:Interaction.Behaviors>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock
                    FontSize="30"
                    FontWeight="SemiBold"
                    Text="Vault" />
                <TextBlock Opacity="0.7" Text="Items are loaded from the local encrypted cache and decrypted in memory." />
            </StackPanel>

            <ProgressRing
                Grid.Column="1"
                Width="28"
                Height="28"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.OpenSettingsCommand, Mode=OneWay}"
                Content="Settings" />

            <Button
                Grid.Column="3"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.LockCommand, Mode=OneWay}"
                Content="Lock" />

            <Button
                Grid.Column="4"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"
                Content="Refresh" />

            <Button
                Grid.Column="5"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.LogoutCommand, Mode=OneWay}"
                Content="Log out" />
        </Grid>

        <InfoBar
            Title="Vault load failed"
            Grid.Row="1"
            Margin="0,16,0,0"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <ListView
            Grid.Row="2"
            Margin="0,16,0,0"
            ItemsSource="{x:Bind ViewModel.Ciphers, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:VaultCipherRow">
                    <Border
                        Margin="0,0,0,8"
                        Padding="16"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{x:Bind Name, Mode=OneWay}" />
                            <TextBlock Opacity="0.8" Text="{x:Bind Username, Mode=OneWay}" />
                            <TextBlock
                                FontFamily="Consolas"
                                Text="{x:Bind Password, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                Opacity="0.65"
                                Text="{x:Bind Urls, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                            <InfoBar
                                Title="Partial item"
                                IsOpen="{x:Bind HasDecryptionError, Mode=OneWay}"
                                Message="This item could not be fully decrypted with the currently available keys."
                                Severity="Warning" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
