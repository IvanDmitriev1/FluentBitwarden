<?xml version="1.0" encoding="utf-8" ?>
<lifecycle:LifecyclePage
    x:Class="FluentBitwarden.Views.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attachedProperties="using:FluentBitwarden.Resources.AttachedProperties"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:lifecycle="using:FluentBitwarden.Resources.Controls.Lifecycle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    attachedProperties:TitlebarProperties.NavigationFrame="{x:Bind ContentFrame}"
    attachedProperties:TitlebarProperties.PaneToggleCommand="{x:Bind PaneToggleCommand}"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <interactivity:Interaction.Behaviors>
        <behaviors:FocusBehavior>
            <behaviors:FocusTarget Control="{x:Bind AutoSuggestBox}" />
        </behaviors:FocusBehavior>
    </interactivity:Interaction.Behaviors>

    <lifecycle:LifecyclePage.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="F"
            Invoked="SearchKeyboardAccelerator_Invoked"
            Modifiers="Control" />
    </lifecycle:LifecyclePage.KeyboardAccelerators>

    <attachedProperties:TitlebarProperties.Content>
        <AutoSuggestBox
            x:Name="AutoSuggestBox"
            Width="360"
            VerticalAlignment="Center"
            PlaceholderText="Search.."
            QueryIcon="Find" />
    </attachedProperties:TitlebarProperties.Content>

    <NavigationView
        x:Name="Nav"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="True"
        ItemInvoked="Nav_OnItemInvoked"
        OpenPaneLength="200"
        PaneDisplayMode="Auto">

        <NavigationView.MenuItems>
            <NavigationViewItem
                Content="Vault"
                Icon="Library"
                Tag="vault" />
            <NavigationViewItem
                Content="Generator"
                Icon="Shuffle"
                Tag="generator" />
            <NavigationViewItem
                Content="Send"
                Icon="Send"
                Tag="send" />
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" Navigated="ContentFrame_OnNavigated" />
    </NavigationView>
</lifecycle:LifecyclePage>
