<?xml version="1.0" encoding="utf-8" ?>
<lifecycle:LifecyclePage
    x:Class="FluentBitwarden.Views.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lifecycle="using:FluentBitwarden.Resources.Controls.Lifecycle"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FluentBitwarden.Views.Settings.Models"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <lifecycle:LifecyclePage.Resources>
        <models:ThemeOptionConverter x:Name="ThemeOptionConverter" />
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="1,30,0,6" />
        </Style>
    </lifecycle:LifecyclePage.Resources>

    <ScrollViewer Padding="22">
        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

            <TextBlock
                Margin="0,0,0,12"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="Settings" />

            <!--  Appearance  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Appearance" />

            <controls:SettingsCard Description="Choose how the app looks." Header="Theme">
                <ComboBox ItemsSource="{x:Bind models:ThemeOption.Options}" SelectedItem="{x:Bind ViewModel.Theme.Value, Mode=TwoWay, Converter={StaticResource ThemeOptionConverter}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ThemeOption">
                            <TextBlock Text="{x:Bind Title}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </controls:SettingsCard>

            <!--  Security  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Security" />

            <controls:SettingsCard Description="Lock the vault when Windows goes to sleep." Header="Lock on system suspend" />

            <controls:SettingsCard Description="Minutes before the unlocked vault is locked automatically." Header="Vault timeout" />

            <!--  About  -->
            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="About" />

            <controls:SettingsExpander Description="Version, storage, and diagnostics." Header="Application">
                <TextBlock Text="MyPasswordManager 0.1.0" />

                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Command="{x:Bind ViewModel.TestCommand}"
                        Description="Open the local application data folder."
                        Header="Open data folder"
                        IsClickEnabled="True" />

                    <controls:SettingsCard
                        Description="Open the diagnostics log folder."
                        Header="Open logs"
                        IsClickEnabled="True" />

                    <controls:SettingsCard Description="Restore all settings to their default values." Header="Reset settings">
                        <Button Content="Reset" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="Remove cached vault data and force a fresh reload next time." Header="Clear local cache">
                        <Button Content="Clear cache" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</lifecycle:LifecyclePage>
