<?xml version="1.0" encoding="utf-8"?>
<ui:CorePage
    x:Class="FluentBitwarden.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attached="using:FluentBitwarden.Views.AttachedProperties"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:FluentBitwarden.Ui.Controls"
    xmlns:viewModels="using:FluentBitwarden.ViewModels"
    mc:Ignorable="d">

    <Grid HorizontalAlignment="Center"
          VerticalAlignment="Center"
          MinWidth="320"
          Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center">
            <TextBlock Text="Your vault is locked"
                       TextAlignment="Center"
                       Style="{StaticResource TitleLargeTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.SessionDisplay.Email, Mode=OneWay}"
                       TextAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Opacity="0.8" />
        </StackPanel>

        <Border Grid.Row="1"
                CornerRadius="16"
                Padding="28"
                Margin="0, 20, 0, 0"
                BorderThickness="1"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
            <Border.Background>
                <SolidColorBrush Color="{ThemeResource CardBackgroundFillColorDefault}"
                                 Opacity="0.92" />
            </Border.Background>

            <StackPanel Spacing="18">
                <controls:Segmented ItemsSource="{x:Bind ViewModel.UnlockMethods, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedUnlockMethod, Mode=TwoWay}"
                                    Visibility="{x:Bind ViewModel.HasUnlockMethodSelector, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                                    HorizontalAlignment="Center">
                    <controls:Segmented.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:LoginUnlockMethodItem">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
                        </DataTemplate>
                    </controls:Segmented.ItemTemplate>
                </controls:Segmented>

                <StackPanel Spacing="12"
                            Visibility="{x:Bind ViewModel.HasSelectedUnlockMethod, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                            >
                    <TextBlock Text="{x:Bind ViewModel.CurrentUnlockMethod.Title, Mode=OneWay}"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold" />

                    <TextBlock Text="{x:Bind ViewModel.CurrentUnlockMethod.Description, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.CurrentUnlockMethod.HasDescription, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                               Opacity="0.75"
                               TextWrapping="WrapWholeWords"
                               HorizontalAlignment="Center"/>

                    <PasswordBox Header="{x:Bind ViewModel.CurrentUnlockMethod.SecretInputHeader, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.CurrentUnlockMethod.HasSecretInput, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                                 attached:PasswordBoxBinding.BindPassword="True"
                                 attached:PasswordBoxBinding.BoundPassword="{x:Bind ViewModel.CurrentUnlockMethod.SecretInput, Mode=TwoWay}" />

                    <Button Style="{StaticResource AccentButtonStyle}"
                            Content="{x:Bind ViewModel.CurrentUnlockMethod.UnlockActionText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CurrentUnlockMethod.UnlockCommand, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CurrentUnlockMethod.HasUnlockAction, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>

                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="28"
                              Height="28"
                              Visibility="{x:Bind ViewModel.IsBusy, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                              HorizontalAlignment="Center" />

                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Severity="Error"
                         Title="Unlock failed"
                         Visibility="Collapsed"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <Button Content="Use another account"
                        Command="{x:Bind ViewModel.UseAnotherAccountCommand, Mode=OneWay}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>
    </Grid>
</ui:CorePage>
