<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentBitwarden.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attachedProperties="using:FluentBitwarden.Ui.AttachedProperties"
    xmlns:behaviors="using:FluentBitwarden.Ui.Behaviors"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls1="using:FluentBitwarden.Ui.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:FluentBitwarden.ViewModels"
    mc:Ignorable="d">

    <interactivity:Interaction.Behaviors>
        <behaviors:PageLifecycleBehavior />
    </interactivity:Interaction.Behaviors>

    <Grid
        MinWidth="470"
        MaxWidth="750"
        Margin="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock
                Style="{StaticResource TitleLargeTextBlockStyle}"
                Text="Your vault is locked"
                TextAlignment="Center" />
            <TextBlock
                Opacity="0.8"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.SessionDisplay.Email, Mode=OneWay}"
                TextAlignment="Center" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,20,0,0"
            Padding="28"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16">
            <Border.Background>
                <SolidColorBrush Opacity="0.92" Color="{ThemeResource CardBackgroundFillColorDefault}" />
            </Border.Background>

            <StackPanel Spacing="18">
                <controls:Segmented
                    HorizontalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.UnlockMethods, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedUnlockMethod, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.HasUnlockMethodSelector, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                    <controls:Segmented.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:LoginUnlockMethodItem">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
                        </DataTemplate>
                    </controls:Segmented.ItemTemplate>
                </controls:Segmented>

                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasSelectedUnlockMethod, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.CurrentUnlockMethod.Title, Mode=OneWay}" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        Opacity="0.75"
                        Text="{x:Bind ViewModel.CurrentUnlockMethod.Description, Mode=OneWay}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{x:Bind ViewModel.CurrentUnlockMethod.HasDescription, Converter={StaticResource BoolToVis}, Mode=OneWay}" />

                    <controls1:ValidatedField Visibility="{x:Bind ViewModel.CurrentUnlockMethod.HasSecretInput, Converter={StaticResource BoolToVis}, Mode=OneWay}" Property="{x:Bind ViewModel.CurrentUnlockMethod.SecretInputValidation, Mode=OneWay}">
                        <PasswordBox
                            attachedProperties:PasswordBoxBinding.BindPassword="True"
                            attachedProperties:PasswordBoxBinding.BoundPassword="{x:Bind ViewModel.CurrentUnlockMethod.SecretInput, Mode=TwoWay}"
                            Header="{x:Bind ViewModel.CurrentUnlockMethod.SecretInputHeader, Mode=OneWay}" />
                    </controls1:ValidatedField>

                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.CurrentUnlockMethod.UnlockCommand, Mode=OneWay}"
                        Content="{x:Bind ViewModel.CurrentUnlockMethod.UnlockActionText, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.CurrentUnlockMethod.HasUnlockAction, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                </StackPanel>

                <ProgressRing
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Converter={StaticResource BoolToVis}, Mode=OneWay}" />

                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.UseAnotherAccountCommand, Mode=OneWay}"
                    Content="Use another account" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
