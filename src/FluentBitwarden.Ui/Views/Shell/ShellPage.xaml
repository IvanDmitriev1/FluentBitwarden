<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentBitwarden.Views.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attachedProperties="using:FluentBitwarden.AttachedProperties"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nav="using:Navis.WinUI"
    xmlns:settings="using:FluentBitwarden.Views.Settings"
    xmlns:templates1="using:FluentBitwarden.Templates"
    xmlns:vault="using:FluentBitwarden.Controls.VaultCiphers"
    xmlns:views="using:FluentBitwarden.Views.Vault"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <templates1:VaultCipherAutosuggestItemTemplates />
            </ResourceDictionary.MergedDictionaries>
            <x:String x:Key="ShellVaultSearchAutomationName">Vault search</x:String>
            <x:String x:Key="ShellNavigationAutomationName">Main navigation</x:String>
        </ResourceDictionary>
    </Page.Resources>

    <interactivity:Interaction.Behaviors>
        <behaviors:FocusBehavior>
            <behaviors:FocusTarget Control="{x:Bind VaultCipherSearchBox}" />
        </behaviors:FocusBehavior>
    </interactivity:Interaction.Behaviors>

    <Page.KeyboardAccelerators>
        <attachedProperties:FocusKeyboardAccelerator
            Key="F"
            Modifiers="Control"
            Target="{x:Bind VaultCipherSearchBox}" />
    </Page.KeyboardAccelerators>

    <NavigationView
        x:Name="Nav"
        nav:NavigationViewProperties.Frame="{x:Bind ContentFrame}"
        nav:TitleBarNavigation.IsPaneTarget="True"
        AutomationProperties.AutomationId="ShellNavigationView"
        AutomationProperties.Name="{StaticResource ShellNavigationAutomationName}"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="200"
        PaneDisplayMode="Auto">

        <NavigationView.MenuItems>
            <NavigationViewItem
                nav:Navigate.To="{nav:XamlType TypeName=views:VaultPage}"
                Content="Vault"
                Icon="Library" />
            <NavigationViewItem
                Content="Generator"
                Icon="Shuffle"
                IsEnabled="False" />
            <NavigationViewItem
                Content="Send"
                Icon="Send"
                IsEnabled="False" />
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem
                nav:Navigate.To="{nav:XamlType TypeName=settings:SettingsPage}"
                Content="Settings"
                Icon="Setting" />
        </NavigationView.FooterMenuItems>

        <Frame
            x:Name="ContentFrame"
            nav:NavigationHost.InitialPage="{nav:XamlType TypeName=views:VaultPage}"
            nav:NavigationHost.IsEnabled="True"
            nav:TitleBarNavigation.IsBackTarget="True">

            <nav:TitleBarNavigation.PersistentContent>
                <vault:VaultCipherSearchBox
                    x:Name="VaultCipherSearchBox"
                    AutomationProperties.AutomationId="ShellVaultCipherSearchBox"
                    AutomationProperties.Name="{StaticResource ShellVaultSearchAutomationName}"
                    VaultCipherSelectedCommand="{x:Bind ViewModel.VaultCipherSelectedCommand}" />
            </nav:TitleBarNavigation.PersistentContent>
        </Frame>
    </NavigationView>
</Page>
