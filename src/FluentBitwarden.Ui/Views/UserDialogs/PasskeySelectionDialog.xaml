<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="FluentBitwarden.Views.UserDialogs.PasskeySelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contracts="using:BitwardenApi.Vault.Items.Contracts"
    xmlns:converters="using:FluentBitwarden.Infrastructure.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentBitwarden.Views.UserDialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:siteIcon="using:FluentBitwarden.Controls.Shared.SiteIcon"
    Title="Select a passkey"
    CloseButtonText="Cancel"
    DefaultButton="Close"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <Style BasedOn="{StaticResource DefaultContentDialogStyle}" TargetType="local:PasskeySelectionDialog" />
        <converters:StringToUriConverter x:Key="StringToUriConverter" />
    </ContentDialog.Resources>

    <Grid MinWidth="400" MaxWidth="440">
        <ListView
            x:Name="CredentialList"
            x:Load="{x:Bind HasItems}"
            ItemsSource="{x:Bind Credentials}"
            SelectionChanged="CredentialList_SelectionChanged"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ListViewItemPresenter
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    PointerOverBackground="{ThemeResource SystemControlHighlightListLowBrush}"
                                    PressedBackground="{ThemeResource SystemControlHighlightListLowBrush}"
                                    SelectedBackground="{ThemeResource SystemControlHighlightListLowBrush}"
                                    SelectedPointerOverBackground="{ThemeResource SystemControlHighlightListLowBrush}"
                                    SelectedPressedBackground="{ThemeResource SystemControlHighlightListLowBrush}"
                                    SelectionCheckMarkVisualEnabled="False" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="contracts:Fido2Credential">
                    <Grid
                        Padding="12"
                        VerticalAlignment="Center"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <siteIcon:SiteIcon Grid.Column="0" Uri="{x:Bind RpId, Converter={StaticResource StringToUriConverter}}" />

                        <StackPanel Grid.Column="1">
                            <TextBlock
                                Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                                Text="{x:Bind UserName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Opacity="0.72"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind UserDisplayName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Opacity="0.72"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind RpName}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            x:Name="EmptyStatePanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            x:Load="{x:Bind HasNoItems}"
            Spacing="8">
            <SymbolIcon Opacity="0.65" Symbol="Important" />
            <TextBlock
                Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                Text="No passkeys found"
                TextAlignment="Center" />
            <TextBlock
                Opacity="0.70"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="There are no FIDO2 credentials in this vault"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</ContentDialog>
