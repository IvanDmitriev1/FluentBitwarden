<?xml version="1.0" encoding="utf-8" ?>
<UserControl
	x:Class="FluentBitwarden.Ui.Features.Vault.CipherDetails.VaultPasswordField"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:FluentBitwarden.Ui.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:FluentBitwarden.Ui.Features.Vault.CipherDetails"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.ThemeDictionaries>
				<ResourceDictionary x:Key="Light">
					<SolidColorBrush x:Key="PasswordSymbolBrush" Color="#FF9C4029" />
				</ResourceDictionary>
				<ResourceDictionary x:Key="Dark">
					<SolidColorBrush x:Key="PasswordSymbolBrush" Color="#FFFFAA91" />
				</ResourceDictionary>
				<ResourceDictionary x:Key="HighContrast">
					<SolidColorBrush x:Key="PasswordSymbolBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
				</ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>

	<Grid>
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup x:Name="RevealStates">
				<VisualState x:Name="Concealed">
					<VisualState.Setters>
						<Setter Target="PART_RevealMenuItem.Visibility" Value="Visible" />
						<Setter Target="PART_ConcealMenuItem.Visibility" Value="Collapsed" />
					</VisualState.Setters>
				</VisualState>

				<VisualState x:Name="Revealed">
					<VisualState.Setters>
						<Setter Target="PART_RevealMenuItem.Visibility" Value="Collapsed" />
						<Setter Target="PART_ConcealMenuItem.Visibility" Value="Visible" />
					</VisualState.Setters>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>

		<controls:FieldActionRow
			x:Name="PART_FieldRow"
			Command="{StaticResource CopyTextCommand}"
			CommandParameter="{x:Bind Password, Mode=OneWay}">
			<controls:FieldActionRow.ActionsFlyout>
				<MenuFlyout Placement="BottomEdgeAlignedRight">
					<MenuFlyoutItem
						x:Name="PART_RevealMenuItem"
						x:Uid="VaultPasswordFieldRevealMenuItem"
						AutomationProperties.AutomationId="VaultPasswordFieldRevealMenuItem"
						Click="RevealMenuItem_Click"
						Text="Reveal" />
					<MenuFlyoutItem
						x:Name="PART_ConcealMenuItem"
						x:Uid="VaultPasswordFieldConcealMenuItem"
						AutomationProperties.AutomationId="VaultPasswordFieldConcealMenuItem"
						Click="ConcealMenuItem_Click"
						Text="Conceal"
						Visibility="Collapsed" />
				</MenuFlyout>
			</controls:FieldActionRow.ActionsFlyout>
			<TextBlock
				AutomationProperties.AutomationId="VaultPasswordFieldValue"
				FontSize="14"
				Text="{x:Bind DisplayText, Mode=OneWay}"
				TextWrapping="Wrap">
				<TextBlock.TextHighlighters>
					<TextHighlighter
						x:Name="PasswordDigits"
						Background="Transparent"
						Foreground="{ThemeResource LinkBrush}" />
					<TextHighlighter
						x:Name="PasswordSymbols"
						Background="Transparent"
						Foreground="{ThemeResource PasswordSymbolBrush}" />
				</TextBlock.TextHighlighters>
			</TextBlock>
		</controls:FieldActionRow>
	</Grid>
</UserControl>
