	<DataTemplate x:Key="SshKeyDetailsTemplate" x:DataType="models:SshKeyCipher">
		<StackPanel Spacing="12">
			<controls:CardGroup Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource HairlineBrush}">
				<controls:CardGroup.Items>
					<controls:FieldActionRow
						x:Uid="VaultSshFingerprint"
						AutomationProperties.AutomationId="VaultSshFingerprintField"
						Command="{StaticResource CopyTextCommand}"
						CommandParameter="{x:Bind KeyFingerprint, Mode=OneTime}"
						Content="{x:Bind KeyFingerprint, Mode=OneTime}"
						Visibility="{x:Bind KeyFingerprint, Mode=OneTime, Converter={StaticResource StringVisibilityConverter}}" />
					<controls:FieldActionRow
						x:Uid="VaultSshPublicKey"
						AutomationProperties.AutomationId="VaultSshPublicKeyField"
						Command="{StaticResource CopyTextCommand}"
						CommandParameter="{x:Bind PublicKey.RawKey, Mode=OneTime}"
						Visibility="{x:Bind PublicKey.RawKey, Mode=OneTime, Converter={StaticResource StringVisibilityConverter}}">
						<TextBlock
							AutomationProperties.AutomationId="VaultSshPublicKeyText"
							Text="{x:Bind PublicKey.RawKey, Mode=OneTime}"
							TextWrapping="Wrap" />
					</controls:FieldActionRow>
					<local:VaultPasswordField
						x:Uid="VaultSshPrivateKey"
						AutomationProperties.AutomationId="VaultSshPrivateKeyField"
						CipherId="{x:Bind Id, Mode=OneTime}"
						Password="{x:Bind PrivateKey, Mode=OneTime}"
						Visibility="{x:Bind PrivateKey, Mode=OneTime, Converter={StaticResource StringVisibilityConverter}}" />
				</controls:CardGroup.Items>
			</controls:CardGroup>
		</StackPanel>
	</DataTemplate>

	<cipherDetails:VaultCipherDetailsTemplateSelector
		x:Key="VaultCipherDetailsTemplateSelector"
		CardTemplate="{StaticResource CardDetailsTemplate}"
		IdentityTemplate="{StaticResource IdentityDetailsTemplate}"
		LoginTemplate="{StaticResource LoginDetailsTemplate}"
		SecureNoteTemplate="{StaticResource SecureNoteDetailsTemplate}"
		SshKeyTemplate="{StaticResource SshKeyDetailsTemplate}" />

</ResourceDictionary>
