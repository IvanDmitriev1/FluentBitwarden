<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
	x:Class="FluentBitwarden.Ui.Features.Vault.CipherDetails.VaultCipherDetailsTemplates"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cipherDetails="using:FluentBitwarden.Ui.Features.Vault.CipherDetails"
	xmlns:controls="using:FluentBitwarden.Ui.Controls"
	xmlns:local="using:FluentBitwarden.Ui.Features.Vault.CipherDetails"
	xmlns:models="using:BitwardenApi.Vault.Ciphers.Models">

	<local:DownloadAttachmentCommand x:Key="DownloadAttachmentCommand" />

	<DataTemplate x:Key="LoginDetailsTemplate" x:DataType="models:LoginCipher">
		<StackPanel Spacing="12">
			<controls:CardGroup Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource HairlineBrush}">
				<controls:CardGroup.Items>
					<controls:FieldActionRow
						x:Uid="VaultUsernameField"
						Command="{StaticResource CopyTextCommand}"
						CommandParameter="{x:Bind Username, Mode=OneTime}"
						Content="{x:Bind Username}" />
					<local:VaultPasswordField
						x:Uid="VaultPasswordRow"
						AutomationProperties.AutomationId="VaultPasswordField"
						CipherId="{x:Bind Id, Mode=OneTime}"
						Password="{x:Bind Password, Mode=OneTime}" />
					<controls:FieldActionRow
						x:Uid="VaultTotpRow"
						ActionText="Copy"
						Command="{StaticResource CopyTextCommand}"
						CommandParameter="{x:Bind Totp, Mode=OneTime}"
						Label="TOTP"
						Visibility="{x:Bind Totp, Mode=OneTime, Converter={StaticResource NullToVisibilityConverter}}">
						<controls:TotpCodeControl HideCode="True" Totp="{x:Bind Totp}" />
					</controls:FieldActionRow>
				</controls:CardGroup.Items>
			</controls:CardGroup>
		</StackPanel>
	</DataTemplate>

	<DataTemplate x:Key="SecureNoteDetailsTemplate" x:DataType="models:SecureNoteCipher">
		<StackPanel Spacing="12">
			<controls:CardGroup Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource HairlineBrush}">
				<controls:CardGroup.Items>
					<controls:FieldActionRow
						x:Uid="VaultSecureNoteNotes"
						AutomationProperties.AutomationId="VaultSecureNoteNotesField"
						Command="{StaticResource CopyTextCommand}"
						CommandParameter="{x:Bind Notes, Mode=OneTime}"
						Visibility="{x:Bind Notes, Mode=OneTime, Converter={StaticResource StringVisibilityConverter}}">
						<TextBlock
							AutomationProperties.AutomationId="VaultSecureNoteNotesText"
							Text="{x:Bind Notes, Mode=OneTime}"
							TextWrapping="Wrap" />
					</controls:FieldActionRow>
				</controls:CardGroup.Items>
			</controls:CardGroup>
		</StackPanel>
	</DataTemplate>

	<DataTemplate x:Key="CardDetailsTemplate" x:DataType="models:CardCipher">
		<StackPanel Spacing="12">
			<controls:CardGroup Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource HairlineBrush}">
				<controls:CardGroup.Items>
					<controls:FieldActionRow
						x:Uid="VaultCardCardholderName"
						AutomationProperties.AutomationId="VaultCardCardholderNameField"
						Command="{StaticResource CopyTextCommand}"
						CommandParameter="{x:Bind CardholderName, Mode=OneTime}"
						Content="{x:Bind CardholderName, Mode=OneTime}"
						Visibility="{x:Bind CardholderName, Mode=OneTime, Converter={StaticResource StringVisibilityConverter}}" />
					<controls:FieldActionRow
						x:Uid="VaultCardBrand"
						AutomationProperties.AutomationId="VaultCardBrandField"
						Command="{StaticResource CopyTextCommand}"
						CommandParameter="{x:Bind Brand, Mode=OneTime}"
						Content="{x:Bind Brand, Mode=OneTime}"
						Visibility="{x:Bind Brand, Mode=OneTime, Converter={StaticResource StringVisibilityConverter}}" />
					<local:VaultPasswordField
						x:Uid="VaultCardNumber"
						AutomationProperties.AutomationId="VaultCardNumberField"
						CipherId="{x:Bind Id, Mode=OneTime}"
						Password="{x:Bind Number, Mode=OneTime}"
						Visibility="{x:Bind Number, Mode=OneTime, Converter={StaticResource StringVisibilityConverter}}" />
					<controls:FieldActionRow
						x:Uid="VaultCardExpMonth"
						AutomationProperties.AutomationId="VaultCardExpMonthField"
						Command="{StaticResource CopyTextCommand}"
						CommandParameter="{x:Bind ExpMonth, Mode=OneTime}"
						Content="{x:Bind ExpMonth, Mode=OneTime}"
						Visibility="{x:Bind ExpMonth, Mode=OneTime, Converter={StaticResource StringVisibilityConverter}}" />
					<controls:FieldActionRow
						x:Uid="VaultCardExpYear"
						AutomationProperties.AutomationId="VaultCardExpYearField"
						Command="{StaticResource CopyTextCommand}"
						CommandParameter="{x:Bind ExpYear, Mode=OneTime}"
						Content="{x:Bind ExpYear, Mode=OneTime}"
						Visibility="{x:Bind ExpYear, Mode=OneTime, Converter={StaticResource StringVisibilityConverter}}" />
					<local:VaultPasswordField
						x:Uid="VaultCardCode"
						AutomationProperties.AutomationId="VaultCardCodeField"
						CipherId="{x:Bind Id, Mode=OneTime}"
						Password="{x:Bind Code, Mode=OneTime}"
						Visibility="{x:Bind Code, Mode=OneTime, Converter={StaticResource StringVisibilityConverter}}" />
				</controls:CardGroup.Items>
			</controls:CardGroup>
		</StackPanel>
	</DataTemplate>

