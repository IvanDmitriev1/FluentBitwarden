<?xml version="1.0" encoding="utf-8" ?>
<UserControl
	x:Class="FluentBitwarden.Ui.Features.Vault.VaultCipherList.VaultCipherListView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:FluentBitwarden.Ui.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:FluentBitwarden.Ui.Features.Vault.VaultCipherList"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:models="using:BitwardenApi.Vault.Ciphers.Models"
	xmlns:search="using:FluentBitwarden.Contracts.Modules.Vault.Ciphers.Search"
	mc:Ignorable="d"
	KeyboardAcceleratorPlacementMode="Hidden">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="ms-appx:///Features/Vault/VaultCipherList/VaultListStyle.xaml" />
				<local:VaultCipherTemplates />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<controls:ListQueryBar
			x:Name="QueryBar"
			x:Uid="VaultListQueryBar"
			Grid.Row="0"
			Margin="10,10,30,10"
			SearchText="{x:Bind SearchText, Mode=TwoWay}">
			<controls:ListQueryBar.FilterFlyout>
				<MenuFlyout>
					<RadioMenuFlyoutItem
						x:Uid="VaultListAllCategories"
						Command="{x:Bind CategoryChangedCommand}"
						GroupName="VaultCategory"
						IsChecked="True">
						<RadioMenuFlyoutItem.Icon>
							<FontIcon Glyph="&#xE8A9;" />
						</RadioMenuFlyoutItem.Icon>
					</RadioMenuFlyoutItem>
					<RadioMenuFlyoutItem
						x:Uid="VaultListLogins"
						Command="{x:Bind CategoryChangedCommand}"
						CommandParameter="{x:Bind models:CipherType.Login}"
						GroupName="VaultCategory">
						<RadioMenuFlyoutItem.Icon>
							<FontIcon Glyph="&#xE192;" />
						</RadioMenuFlyoutItem.Icon>
					</RadioMenuFlyoutItem>
					<RadioMenuFlyoutItem
						x:Uid="VaultListCreditCards"
						Command="{x:Bind CategoryChangedCommand}"
						CommandParameter="{x:Bind models:CipherType.Card}"
						GroupName="VaultCategory">
						<RadioMenuFlyoutItem.Icon>
							<FontIcon Glyph="&#xE8C7;" />
						</RadioMenuFlyoutItem.Icon>
					</RadioMenuFlyoutItem>
					<RadioMenuFlyoutItem
						x:Uid="VaultListIdentities"
						Command="{x:Bind CategoryChangedCommand}"
						CommandParameter="{x:Bind models:CipherType.Identity}"
						GroupName="VaultCategory">
						<RadioMenuFlyoutItem.Icon>
							<FontIcon Glyph="&#xE77B;" />
						</RadioMenuFlyoutItem.Icon>
					</RadioMenuFlyoutItem>
					<RadioMenuFlyoutItem
						x:Uid="VaultListNotes"
						Command="{x:Bind CategoryChangedCommand}"
						CommandParameter="{x:Bind models:CipherType.SecureNote}"
						GroupName="VaultCategory">
						<RadioMenuFlyoutItem.Icon>
							<FontIcon Glyph="&#xE70B;" />
						</RadioMenuFlyoutItem.Icon>
					</RadioMenuFlyoutItem>
					<RadioMenuFlyoutItem
						x:Uid="VaultListSshKeys"
						Command="{x:Bind CategoryChangedCommand}"
						CommandParameter="{x:Bind models:CipherType.SshKey}"
						GroupName="VaultCategory">
						<RadioMenuFlyoutItem.Icon>
							<FontIcon Glyph="&#xE72E;" />
						</RadioMenuFlyoutItem.Icon>
					</RadioMenuFlyoutItem>
				</MenuFlyout>
			</controls:ListQueryBar.FilterFlyout>
			<controls:ListQueryBar.SortFlyout>
				<MenuFlyout>
					<RadioMenuFlyoutItem
						x:Uid="VaultListNameAscending"
						Command="{x:Bind SortChangedCommand}"
						CommandParameter="{x:Bind search:VaultCipherSortDirection.Ascending}"
						IsChecked="True" />
					<RadioMenuFlyoutItem
						x:Uid="VaultListNameDescending"
						Command="{x:Bind SortChangedCommand}"
						CommandParameter="{x:Bind search:VaultCipherSortDirection.Descending}" />
				</MenuFlyout>
			</controls:ListQueryBar.SortFlyout>
		</controls:ListQueryBar>

		<ListView
			x:Name="CipherList"
			Grid.Row="1"
			ItemTemplate="{StaticResource VaultCipherTemplate}"
			ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
			KeyDown="CipherList_KeyDown"
			SelectedItem="{x:Bind SelectedCipher, Mode=TwoWay}"
			SelectionChanged="CipherList_SelectionChanged"
			Style="{StaticResource VaultListViewStyle}" />
	</Grid>
</UserControl>
