<ResourceDictionary
	x:Class="FluentBitwarden.Ui.Features.Vault.VaultCipherList.VaultCipherTemplates"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:FluentBitwarden.Ui.Controls"
	xmlns:extensions="using:FluentBitwarden.Ui.Infrastructure.Extensions"
	xmlns:models="using:BitwardenApi.Vault.Ciphers.Models">

	<DataTemplate x:Key="VaultCipherTemplate" x:DataType="models:Cipher">
		<Grid Padding="12,8" ColumnSpacing="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<controls:SiteIcon
				Grid.Column="0"
				FallbackGlyph="{x:Bind extensions:VaultCipherExtensions.GetDefaultGlyph((models:Cipher)), Mode=OneTime}"
				Size="32"
				Uri="{x:Bind extensions:VaultCipherExtensions.GetDefaultSiteIconUri((models:Cipher)), Mode=OneTime}" />

			<StackPanel
				Grid.Column="1"
				VerticalAlignment="Center"
				Spacing="2">
				<TextBlock
					FontSize="14"
					FontWeight="SemiBold"
					Foreground="{ThemeResource TextPrimaryBrush}"
					Text="{x:Bind Name, Mode=OneTime}"
					TextTrimming="CharacterEllipsis" />
				<TextBlock
					x:Name="SubTitle"
					x:Load="{x:Bind extensions:VaultCipherExtensions.HasSubtitle((models:Cipher)), Mode=OneTime}"
					FontSize="12"
					Foreground="{ThemeResource TextSecondaryBrush}"
					Text="{x:Bind extensions:VaultCipherExtensions.GetSubtitle((models:Cipher)), Mode=OneTime}"
					TextTrimming="CharacterEllipsis" />
			</StackPanel>
		</Grid>
	</DataTemplate>
</ResourceDictionary>
