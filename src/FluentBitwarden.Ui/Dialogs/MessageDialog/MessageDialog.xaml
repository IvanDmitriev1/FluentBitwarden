<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
	x:Class="FluentBitwarden.Ui.Dialogs.MessageDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
	DefaultButton="Primary"
	PrimaryButtonCommand="{x:Bind ViewModel.PrimaryButtonCommand}"
	PrimaryButtonStyle="{StaticResource PrimaryButtonStyle}"
	PrimaryButtonText="OK"
	Title="{x:Bind ViewModel.Title}">

	<TextBlock
		Style="{StaticResource BodyTextBlockStyle}"
		Text="{x:Bind ViewModel.Message}"
		TextWrapping="Wrap" />

</ContentDialog>
