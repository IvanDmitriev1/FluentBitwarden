<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
	x:Class="FluentBitwarden.Ui.Dialogs.SshKeyApproval.SshKeyApprovalDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
	x:Uid="SshKeyApprovalDialog"
	AutomationProperties.AutomationId="SshKeyApprovalDialog"
	DefaultButton="None"
	PrimaryButtonCommand="{x:Bind ViewModel.PrimaryButtonCommand}"
	PrimaryButtonStyle="{StaticResource PrimaryButtonStyle}">

	<StackPanel Width="420" Spacing="0">
		<Border
			Width="64"
			Height="64"
			Margin="0,8,0,20"
			HorizontalAlignment="Center"
			Background="{ThemeResource SubtleFillColorSecondaryBrush}"
			CornerRadius="16">

			<ImageIcon
				Width="30"
				Height="30"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				AutomationProperties.AccessibilityView="Raw"
				Source="ms-appx:///Assets/terminal.svg" />
		</Border>

		<TextBlock
			Margin="0,0,0,12"
			HorizontalAlignment="Center"
			Style="{StaticResource SubtitleTextBlockStyle}"
			Text="Approve SSH request?"
			TextAlignment="Center"
			TextWrapping="Wrap" />

		<TextBlock
			Margin="8,0,8,24"
			Foreground="{ThemeResource TextFillColorSecondaryBrush}"
			Style="{StaticResource BodyTextBlockStyle}"
			Text="An SSH client wants to use one of your keys to sign an authentication request."
			TextAlignment="Center"
			TextWrapping="Wrap" />

		<!--  Request information  -->
		<StackPanel Spacing="12">
			<TextBlock
				x:Uid="SshKeyApprovalForwardingIndicator"
				HorizontalAlignment="Center"
				Style="{StaticResource BodyStrongTextBlockStyle}"
				Visibility="{x:Bind ViewModel.IsForwarded, Mode=OneTime, Converter={StaticResource BoolToVisConverter}}" />

			<Border
				Padding="12"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="8"
				Visibility="{x:Bind ViewModel.Destination, Converter={StaticResource NullToVisibilityConverter}}">

				<Grid ColumnSpacing="14">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="48" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<Border
						Width="48"
						Height="48"
						Background="{ThemeResource SubtleFillColorSecondaryBrush}"
						CornerRadius="12">

						<ImageIcon
							Width="24"
							Height="24"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							AutomationProperties.AccessibilityView="Raw"
							Source="ms-appx:///Assets/monitor.svg" />
					</Border>

					<TextBlock
						Grid.Column="1"
						VerticalAlignment="Center"
						Style="{StaticResource BodyStrongTextBlockStyle}"
						Text="{x:Bind ViewModel.Destination}"
						TextTrimming="CharacterEllipsis" />

				</Grid>
			</Border>

			<!--  SSH key  -->
			<Border
				Padding="12"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="8">

				<Grid ColumnSpacing="14">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="48" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<!--  Key icon  -->
					<Border
						Width="48"
						Height="48"
						Background="{ThemeResource SubtleFillColorSecondaryBrush}"
						CornerRadius="12">

						<FontIcon
							FontSize="24"
							Foreground="{ThemeResource AccentFillColorDefaultBrush}"
							Glyph="&#xE8D7;" />
					</Border>

					<!--  Key details  -->
					<StackPanel
						Grid.Column="1"
						VerticalAlignment="Center"
						Spacing="4">

						<TextBlock
							MaxLines="2"
							Style="{StaticResource BodyStrongTextBlockStyle}"
							Text="{x:Bind ViewModel.KeyName, Mode=OneWay}"
							TextTrimming="CharacterEllipsis"
							TextWrapping="Wrap" />

						<TextBlock
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Style="{StaticResource CaptionTextBlockStyle}"
							Text="SSH key" />

					</StackPanel>
				</Grid>
			</Border>

		</StackPanel>

		<!--  Approval scope  -->
		<Grid Margin="4,20,4,4" ColumnSpacing="10">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<FontIcon
				VerticalAlignment="Center"
				FontSize="16"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Glyph="&#xE946;" />

			<TextBlock
				Grid.Column="1"
				VerticalAlignment="Center"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Style="{StaticResource CaptionTextBlockStyle}"
				Text="This approval is valid for this request only."
				TextWrapping="Wrap" />

		</Grid>

	</StackPanel>

</ContentDialog>
