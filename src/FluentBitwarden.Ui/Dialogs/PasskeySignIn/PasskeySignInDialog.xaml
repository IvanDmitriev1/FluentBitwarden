<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
	x:Class="FluentBitwarden.Ui.Dialogs.PasskeySignIn.PasskeySignInDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:FluentBitwarden.Ui.Controls"
	x:Uid="PasskeySignInDialog"
	AutomationProperties.AutomationId="PasskeySignInDialog"
	CloseButtonStyle="{StaticResource SecondaryButtonStyle}"
	DefaultButton="None"
	PrimaryButtonCommand="{x:Bind ViewModel.SignInCommand}"
	PrimaryButtonStyle="{StaticResource PrimaryButtonStyle}">

	<StackPanel Width="320">
		<Border
			Width="56"
			Height="56"
			Margin="0,4,0,12"
			HorizontalAlignment="Center"
			AutomationProperties.AutomationId="PasskeySiteIcon"
			Background="{ThemeResource SubtleFillColorSecondaryBrush}"
			CornerRadius="12">
			<controls:SiteIcon
				Width="36"
				Height="36"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				AutomationProperties.AccessibilityView="Raw"
				FallbackGlyph="&#xE774;"
				Size="32"
				Uri="{x:Bind ViewModel.Candidate.SiteIconUri}" />
		</Border>

		<TextBlock
			Margin="0,0,0,6"
			HorizontalAlignment="Center"
			Style="{StaticResource SubtitleTextBlockStyle}"
			Text="{x:Bind ViewModel.SiteTitle, Mode=OneTime}"
			TextAlignment="Center"
			TextWrapping="Wrap" />

		<TextBlock
			x:Uid="PasskeySignInSubtitle"
			Margin="0,0,0,16"
			Foreground="{ThemeResource TextFillColorSecondaryBrush}"
			Style="{StaticResource BodyTextBlockStyle}"
			TextAlignment="Center"
			TextWrapping="Wrap" />

		<Border
			Padding="16"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="8">

			<Grid ColumnSpacing="16">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="32" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<FontIcon
					Grid.Column="0"
					VerticalAlignment="Center"
					FontSize="24"
					Glyph="&#xE8D7;" />

				<StackPanel
					Grid.Column="1"
					VerticalAlignment="Center"
					Spacing="4">

					<TextBlock
						x:Uid="PasskeySignInPasskeyLabel"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Style="{StaticResource CaptionTextBlockStyle}"
						TextAlignment="Left" />

					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock
							VerticalAlignment="Center"
							MaxLines="2"
							Style="{StaticResource BodyStrongTextBlockStyle}"
							Text="{x:Bind ViewModel.Candidate.ItemName, Mode=OneTime}"
							TextAlignment="Center"
							TextTrimming="CharacterEllipsis"
							TextWrapping="Wrap" />

						<TextBlock
							VerticalAlignment="Center"
							FontSize="14"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="·" />

						<TextBlock
							VerticalAlignment="Center"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							MaxLines="2"
							Style="{StaticResource CaptionTextBlockStyle}"
							Text="{x:Bind ViewModel.Candidate.VaultName, Mode=OneTime}"
							TextAlignment="Center"
							TextTrimming="CharacterEllipsis"
							TextWrapping="Wrap" />

					</StackPanel>
				</StackPanel>
			</Grid>
		</Border>
	</StackPanel>
</ContentDialog>
