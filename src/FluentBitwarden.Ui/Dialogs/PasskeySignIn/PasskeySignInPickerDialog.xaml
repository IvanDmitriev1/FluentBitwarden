<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
	x:Class="FluentBitwarden.Ui.Dialogs.PasskeySignIn.PasskeySignInPickerDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:FluentBitwarden.Ui.Controls"
	xmlns:local="using:FluentBitwarden.Ui.Dialogs.PasskeySignIn"
	x:Uid="PasskeySignInPickerDialog"
	AutomationProperties.AutomationId="PasskeySignInPickerDialog"
	CloseButtonStyle="{StaticResource SecondaryButtonStyle}"
	DefaultButton="None"
	IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSignIn, Mode=OneWay}"
	PrimaryButtonCommand="{x:Bind ViewModel.SignInCommand}"
	PrimaryButtonStyle="{StaticResource PrimaryButtonStyle}">

	<StackPanel Width="380" Spacing="0">
		<Border
			Width="64"
			Height="64"
			Margin="0,8,0,20"
			HorizontalAlignment="Center"
			Background="{ThemeResource SubtleFillColorSecondaryBrush}"
			CornerRadius="16">
			<FontIcon
				Width="32"
				Height="32"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				AutomationProperties.AccessibilityView="Raw"
				FontSize="28"
				Foreground="{ThemeResource AccentFillColorDefaultBrush}"
				Glyph="&#xE8D7;" />
		</Border>

		<TextBlock
			x:Uid="PasskeySignInPickerTitle"
			Margin="0,0,0,12"
			HorizontalAlignment="Center"
			Style="{StaticResource SubtitleTextBlockStyle}"
			TextAlignment="Center"
			TextWrapping="Wrap" />

		<TextBlock
			Margin="8,0,8,20"
			Foreground="{ThemeResource TextFillColorSecondaryBrush}"
			Style="{StaticResource BodyTextBlockStyle}"
			Text="{x:Bind ViewModel.Subtitle, Mode=OneTime}"
			TextAlignment="Center"
			TextWrapping="Wrap" />

		<ListView
			x:Uid="PasskeySignInPickerCandidateList"
			MaxHeight="320"
			Margin="0,0,0,20"
			AutomationProperties.AutomationId="PasskeyCandidateList"
			ItemsSource="{x:Bind ViewModel.Candidates, Mode=OneTime}"
			SelectedItem="{x:Bind ViewModel.SelectedCandidate, Mode=TwoWay}"
			SelectionMode="Single">

			<ListView.ItemTemplate>
				<DataTemplate x:DataType="local:PasskeySignInCandidateViewModel">
					<Grid Padding="8,6" ColumnSpacing="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="44" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<controls:SiteIcon
							Width="44"
							Height="44"
							AutomationProperties.AccessibilityView="Raw"
							FallbackGlyph="&#xE8D7;"
							Size="28"
							Uri="{x:Bind SiteIconUri}" />

						<StackPanel Grid.Column="1" VerticalAlignment="Center">
							<TextBlock
								VerticalAlignment="Center"
								MaxLines="1"
								Style="{StaticResource BodyStrongTextBlockStyle}"
								Text="{x:Bind ItemName}"
								TextTrimming="CharacterEllipsis" />

							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBlock
									VerticalAlignment="Center"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									MaxLines="1"
									Style="{StaticResource CaptionTextBlockStyle}"
									Text="{x:Bind AccountName}"
									TextTrimming="CharacterEllipsis" />

								<TextBlock
									VerticalAlignment="Center"
									FontSize="14"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Text="·" />

								<TextBlock
									VerticalAlignment="Center"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									MaxLines="1"
									Style="{StaticResource CaptionTextBlockStyle}"
									Text="{x:Bind VaultName}"
									TextTrimming="CharacterEllipsis" />
							</StackPanel>
						</StackPanel>
					</Grid>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
	</StackPanel>
</ContentDialog>
