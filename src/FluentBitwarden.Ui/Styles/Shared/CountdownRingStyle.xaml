<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentBitwarden.Controls.Shared">

    <Style TargetType="controls:CountdownRing">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="RingBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="RingTrackBrush" Value="{ThemeResource ControlStrongFillColorDefaultBrush}" />
        <Setter Property="RingThickness" Value="4" />
        <Setter Property="Padding" Value="8,4,10,4" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:CountdownRing">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                        <Grid VerticalAlignment="Center" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                x:Name="PART_RingHost"
                                Grid.Column="0"
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <Ellipse Stroke="{TemplateBinding RingTrackBrush}" StrokeThickness="{TemplateBinding RingThickness}" />

                                <Path
                                    x:Name="PART_RingProgress"
                                    Stroke="{TemplateBinding RingBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="{TemplateBinding RingThickness}" />
                            </Grid>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{TemplateBinding ValueText}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
