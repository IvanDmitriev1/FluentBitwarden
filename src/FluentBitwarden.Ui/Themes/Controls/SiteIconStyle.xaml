<?xml version="1.0" encoding="utf-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentBitwarden.Ui.Controls">

    <Style TargetType="controls:SiteIcon">
        <Setter Property="Size" Value="28" />
        <Setter Property="FallbackGlyph" Value="&#xE774;" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SiteIcon">
                    <Grid Width="{TemplateBinding Size}" Height="{TemplateBinding Size}">

                        <FontIcon
                            x:Name="PART_FallbackIcon"
                            FontSize="{TemplateBinding Size}"
                            Foreground="{TemplateBinding Foreground}"
                            Glyph="{TemplateBinding FallbackGlyph}"
                            IsHitTestVisible="False" />

                        <Border CornerRadius="4">
                            <Image
                                x:Name="PART_Image"
                                IsHitTestVisible="False"
                                Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
