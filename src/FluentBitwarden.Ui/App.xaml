<?xml version="1.0" encoding="utf-8" ?>
<Application
	x:Class="FluentBitwarden.Ui.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviours="using:FluentBitwarden.Ui.Behaviours">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
				<ResourceDictionary Source="ms-appx:///Themes/Colors.xaml" />
				<ResourceDictionary Source="ms-appx:///Themes/Metrics.xaml" />
				<ResourceDictionary Source="ms-appx:///Themes/Controls.xaml" />
				<ResourceDictionary Source="ms-appx:///Converters/Converters.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<behaviours:CopyTextCommand x:Key="CopyTextCommand" />
		</ResourceDictionary>
	</Application.Resources>
</Application>
