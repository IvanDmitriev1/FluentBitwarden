<?xml version="1.0" encoding="utf-8" ?>
<winUiEx:WindowEx
    x:Class="FluentBitwarden.Ui.Windows.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nav="using:Navis.WinUI"
    xmlns:winUi="using:Navis.WinUI"
    xmlns:winUiEx="using:WinUIEx"
    Title="FluentBitwarden"
    Width="560"
    Height="460"
    mc:Ignorable="d">

    <winUiEx:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </winUiEx:WindowEx.SystemBackdrop>

    <Grid x:Name="RootElement" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="EscapeKeyboardAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="DragArea"
            Grid.Row="0"
            Background="Transparent"
            Canvas.ZIndex="1000" />

        <Frame
            x:Name="RootNavigationFrame"
            Grid.Row="1"
            nav:NavigationHost.IsEnabled="True" />


    </Grid>
</winUiEx:WindowEx>
