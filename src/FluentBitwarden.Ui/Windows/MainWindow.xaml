<?xml version="1.0" encoding="utf-8" ?>
<winUiEx:WindowEx
    x:Class="FluentBitwarden.Ui.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nav="using:Navis.WinUI"
    xmlns:winUi="using:Navis.WinUI"
    xmlns:winUiEx="using:WinUIEx"
    Title="Bitwarden"
    Width="1120"
    Height="680"
    MinWidth="900"
    MinHeight="520"
    PersistenceId="MainWindow"
    mc:Ignorable="d">

    <winUiEx:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </winUiEx:WindowEx.SystemBackdrop>

    <Grid x:Name="RootElement">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="FluentBitwarden"
            Grid.Row="0"
            Height="48"
            winUi:TitleBarNavigation.IsHost="True">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>

            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/icon.svg" />
            </TitleBar.IconSource>

            <TitleBar.Content>
                <Grid Margin="128,0,0,0">
                    <!--  title-bar content  -->
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <Frame
            x:Name="RootNavigationFrame"
            Grid.Row="1"
            nav:NavigationHost.IsEnabled="True" />
    </Grid>

</winUiEx:WindowEx>
