<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkitConverters="using:CommunityToolkit.WinUI.Converters">
    <toolkitConverters:StringVisibilityConverter x:Key="StringVisibilityConverter"  />

    <toolkitConverters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    <toolkitConverters:BoolNegationConverter x:Key="BoolNegationConverter" />
    <toolkitConverters:BoolToObjectConverter
        x:Key="InverseBoolToVisConverter"
        FalseValue="Visible"
        TrueValue="Collapsed" />

    <toolkitConverters:EmptyObjectToObjectConverter
        x:Key="NullToVisibilityConverter"
        EmptyValue="Collapsed"
        NotEmptyValue="Visible" />
    <toolkitConverters:EmptyObjectToObjectConverter
        x:Key="NullToBoolConverter"
        EmptyValue="False"
        NotEmptyValue="True" />
    <toolkitConverters:EmptyStringToObjectConverter
        x:Key="StringToBoolConverter"
        EmptyValue="False"
        NotEmptyValue="True" />
    <toolkitConverters:EmptyCollectionToObjectConverter
        x:Key="EmptyCollectionToVisibilityConverter"
        EmptyValue="Collapsed"
        NotEmptyValue="Visible" />
</ResourceDictionary>
