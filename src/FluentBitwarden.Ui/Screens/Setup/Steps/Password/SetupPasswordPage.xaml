<Page
	x:Class="FluentBitwarden.Ui.Screens.Setup.Steps.Password.SetupPasswordPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:FluentBitwarden.Ui.Controls"
	xmlns:password="using:FluentBitwarden.Ui.Screens.Setup.Steps.Password"
	xmlns:setup="using:FluentBitwarden.Ui.Screens.Setup"
	NavigationCacheMode="Disabled">

	<Grid RowSpacing="22">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Button
			Width="40"
			Height="40"
			HorizontalAlignment="Left"
			AutomationProperties.Name="Back to email and server"
			Command="{x:Bind ViewModel.GoBackCommand, Mode=OneTime}"
			IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
			<FontIcon
				FontFamily="{ThemeResource SymbolThemeFontFamily}"
				FontSize="16"
				Glyph="&#xE72B;" />
		</Button>

		<StackPanel Grid.Row="1" Spacing="22">
			<TextBlock
				HorizontalAlignment="Center"
				Style="{StaticResource TitleLargeTextBlockStyle}"
				Text="Welcome back!"
				TextAlignment="Center" />

			<setup:SetupAccountSummary Email="{x:Bind ViewModel.Email, Mode=OneWay}" ServerDisplayName="{x:Bind ViewModel.ServerDisplayName, Mode=OneWay}" />

			<controls:PasswordBoxEx
				x:Name="Password"
				x:Uid="SetupMasterPasswordBox"
				ActionButtonCommand="{x:Bind ViewModel.LoginCommand, Mode=OneTime}"
				ActionButtonToolTip="Sign in"
				AutomationProperties.AutomationId="SetupMasterPasswordBox"
				AutomationProperties.Name="Master password"
				Command="{x:Bind ViewModel.LoginCommand, Mode=OneTime}"
				Header="Master password"
				IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
				<controls:PasswordBoxEx.Resources>
					<x:String x:Key="PasswordBoxExEmptyActionGlyph">&#xE77B;</x:String>
				</controls:PasswordBoxEx.Resources>
			</controls:PasswordBoxEx>

			<InfoBar
				AutomationProperties.AutomationId="SetupPasswordError"
				AutomationProperties.Name="{x:Bind ViewModel.Error, Mode=OneWay}"
				IsClosable="False"
				IsOpen="{x:Bind ViewModel.Error, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
				Message="{x:Bind ViewModel.Error, Mode=OneWay}"
				Severity="Error" />

			<Button
				Height="36"
				HorizontalAlignment="Stretch"
				AutomationProperties.AutomationId="SetupPasswordContinueButton"
				Command="{x:Bind ViewModel.LoginCommand, Mode=OneTime}"
				CommandParameter="{x:Bind Password.Password, Mode=OneWay}"
				Content="Continue"
				IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
				Style="{StaticResource AccentButtonStyle}" />
		</StackPanel>
	</Grid>
</Page>
