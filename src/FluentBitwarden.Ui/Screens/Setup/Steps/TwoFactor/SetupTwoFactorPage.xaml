<Page
    x:Class="FluentBitwarden.Ui.Screens.Setup.Steps.TwoFactor.SetupTwoFactorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentBitwarden.Ui.Controls"
    xmlns:setup="using:FluentBitwarden.Ui.Screens.Setup"
    xmlns:twoFactor="using:FluentBitwarden.Ui.Screens.Setup.Steps.TwoFactor"
    x:DataType="twoFactor:SetupTwoFactorPageViewModel"
    NavigationCacheMode="Disabled">
    <Grid RowSpacing="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Button
            Width="40"
            Height="40"
            HorizontalAlignment="Left"
            AutomationProperties.Name="Back to email and server"
            Command="{x:Bind ViewModel.GoBackCommand, Mode=OneTime}"
            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
            <FontIcon Glyph="&#xE72B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" />
        </Button>

        <StackPanel Grid.Row="1" Spacing="22">
            <StackPanel HorizontalAlignment="Center" Spacing="4">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleLargeTextBlockStyle}"
                    Text="Two-step verification"
                    TextAlignment="Center" />
                <TextBlock
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    Text="Enter the verification code to finish login."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <setup:SetupAccountSummary
                Email="{x:Bind ViewModel.Email, Mode=OneWay}"
                ServerDisplayName="{x:Bind ViewModel.ServerDisplayName, Mode=OneWay}" />

            <StackPanel Spacing="12">
                <ComboBox
                    HorizontalAlignment="Stretch"
                    Header="Verification method"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    ItemsSource="{x:Bind ViewModel.SupportedProviders, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedProviderOption, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="twoFactor:SetupTwoFactorProviderOption">
                            <TextBlock Text="{x:Bind Title, Mode=OneTime}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    Text="{x:Bind ViewModel.UnsupportedProvidersMessage, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasUnsupportedProviders, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                <ui:TextBoxEx
                    AutomationProperties.AutomationId="SetupVerificationCodeTextBox"
                    Command="{x:Bind ViewModel.SubmitCommand, Mode=OneTime}"
                    Header="Verification code"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="123456"
                    Text="{x:Bind ViewModel.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <InfoBar
                AutomationProperties.AutomationId="SetupTwoFactorError"
                AutomationProperties.Name="{x:Bind ViewModel.Error, Mode=OneWay}"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.Error, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                Severity="Error" />
            <Button
                Height="36"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Verify code"
                Command="{x:Bind ViewModel.SubmitCommand, Mode=OneTime}"
                Content="Continue"
                IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
