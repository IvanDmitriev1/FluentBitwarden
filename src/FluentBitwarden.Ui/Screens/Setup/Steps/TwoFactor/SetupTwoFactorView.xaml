<UserControl
    x:Class="FluentBitwarden.Ui.Screens.Setup.Steps.TwoFactor.SetupTwoFactorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:setup="using:FluentBitwarden.Ui.Screens.Setup.Steps.TwoFactor"
    x:DataType="setup:SetupTwoFactorViewModel">
    <StackPanel Spacing="14">
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="Two-step verification" />
            <TextBlock
                Foreground="{ThemeResource TextSecondaryBrush}"
                Text="{x:Bind ViewModel.Email, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <ComboBox
            Header="Verification method"
            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
            ItemsSource="{x:Bind ViewModel.SupportedProviders, Mode=OneTime}"
            SelectedItem="{x:Bind ViewModel.SelectedProviderOption, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="setup:SetupTwoFactorProviderOption">
                    <TextBlock Text="{x:Bind Title, Mode=OneTime}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock
            Foreground="{ThemeResource TextSecondaryBrush}"
            Text="{x:Bind ViewModel.UnsupportedProvidersMessage, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HasUnsupportedProviders, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
        <TextBox
            Header="Verification code"
            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
            IsSpellCheckEnabled="False"
            Text="{x:Bind ViewModel.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Error, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
            Severity="Error" />
        <Button
            HorizontalAlignment="Stretch"
            AutomationProperties.Name="Verify code"
            Command="{x:Bind ViewModel.SubmitCommand, Mode=OneTime}"
            Content="Verify"
            IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
            Style="{StaticResource AccentButtonStyle}" />
    </StackPanel>
</UserControl>
