<Page
	x:Class="FluentBitwarden.Ui.Screens.Setup.SetupPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:email="using:FluentBitwarden.Ui.Screens.Setup.Steps.Email"
	xmlns:nav="using:Navis.WinUI"
	NavigationCacheMode="Disabled">

	<ScrollViewer
		x:Name="SetupScrollViewer"
		HorizontalScrollBarVisibility="Disabled"
		VerticalScrollBarVisibility="Auto">
		<Grid MinHeight="{x:Bind SetupScrollViewer.ViewportHeight, Mode=OneWay}">
			<Border
				MaxWidth="640"
				Margin="16,0"
				Padding="28"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Center"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="6">
				<Frame
					x:Name="StepFrame"
					nav:NavigationHost.InitialPage="{nav:XamlType TypeName=email:SetupEmailPage}"
					nav:NavigationHost.IsEnabled="True" />
			</Border>
		</Grid>
	</ScrollViewer>
</Page>
