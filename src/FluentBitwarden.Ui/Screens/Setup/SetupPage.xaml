<Page
    x:Class="FluentBitwarden.Ui.Screens.Setup.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:email="using:FluentBitwarden.Ui.Screens.Setup.Steps.Email"
    xmlns:nav="using:Navis.WinUI"
    NavigationCacheMode="Disabled">

    <Border
        Width="560"
        Padding="28"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <Grid>
            <Frame
                x:Name="StepFrame"
                nav:NavigationHost.InitialPage="{nav:XamlType TypeName=email:SetupEmailPage}"
                nav:NavigationHost.IsEnabled="True" />
        </Grid>
    </Border>
</Page>
