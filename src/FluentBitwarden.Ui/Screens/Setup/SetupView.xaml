<UserControl
    x:Class="FluentBitwarden.Ui.Screens.Setup.SetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviours="using:FluentBitwarden.Ui.Behaviours"
    xmlns:email="using:FluentBitwarden.Ui.Screens.Setup.Steps.Email"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:password="using:FluentBitwarden.Ui.Screens.Setup.Steps.Password"
    xmlns:setup="using:FluentBitwarden.Ui.Screens.Setup"
    xmlns:twofactor="using:FluentBitwarden.Ui.Screens.Setup.Steps.TwoFactor"
    x:DataType="setup:SetupViewModel"
    DataContext="{x:Bind ViewModel, Mode=OneWay}">

    <interactivity:Interaction.Behaviors>
        <behaviours:ObservableRecipientBehavior />
    </interactivity:Interaction.Behaviors>

    <UserControl.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="EmailStepTemplate" x:DataType="email:SetupEmailViewModel">
                <email:SetupEmailView ViewModel="{x:Bind}" />
            </DataTemplate>
            <DataTemplate x:Key="PasswordStepTemplate" x:DataType="password:SetupPasswordViewModel">
                <password:SetupPasswordView ViewModel="{x:Bind}" />
            </DataTemplate>
            <DataTemplate x:Key="TwoFactorStepTemplate" x:DataType="twofactor:SetupTwoFactorViewModel">
                <twofactor:SetupTwoFactorView ViewModel="{x:Bind}" />
            </DataTemplate>
            <setup:SetupStepTemplateSelector
                x:Key="SetupStepTemplateSelector"
                EmailTemplate="{StaticResource EmailStepTemplate}"
                PasswordTemplate="{StaticResource PasswordStepTemplate}"
                TwoFactorTemplate="{StaticResource TwoFactorStepTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Width="560"
        Padding="28"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <Grid>
            <Button
                Width="40"
                Height="40"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                AutomationProperties.Name="Back to email and server"
                Command="{x:Bind ViewModel.GoBackCommand, Mode=OneTime}"
                CornerRadius="4"
                Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                <FontIcon
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Glyph="&#xE72B;" />
            </Button>

            <ContentControl
                Margin="0,16,0,0"
                HorizontalContentAlignment="Stretch"
                Content="{x:Bind ViewModel.CurrentStep, Mode=OneWay}"
                ContentTemplateSelector="{StaticResource SetupStepTemplateSelector}" />
        </Grid>
    </Border>
</UserControl>
