{
  "name": "fluent-bitwarden",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "",
  "scripts": {
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",

    "dev:chrome": "vite build --watch --mode chrome",
    "dev:firefox": "vite build --watch --mode firefox",

    "run:firefox": "web-ext run --source-dir dist/firefox",
    "package:firefox": "web-ext build --source-dir dist/firefox --artifacts-dir artifacts/firefox"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.43",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "web-ext": "^10.4.0"
  }
}
