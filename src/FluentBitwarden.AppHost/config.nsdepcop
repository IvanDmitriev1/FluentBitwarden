<?xml version="1.0" encoding="utf-8"?>

<NsDepCopConfig ChildCanDependOnParentImplicitly="true"
                ParentCanDependOnChildImplicitly="false"
                MaxIssueCount="500">


  <!-- Shared framework, platform, API, and contract dependencies are available throughout AppHost. -->
  <Allowed From="FluentBitwarden.*" To="System.*" />
  <Allowed From="FluentBitwarden.*" To="Microsoft.*" />
  <Allowed From="FluentBitwarden.*" To="WinRT.*" />
  <Allowed From="FluentBitwarden.*" To="Windows.*" />
  <Allowed From="FluentBitwarden.*" To="Dapper.*" />
  <Allowed From="FluentBitwarden.*" To="AsyncAwaitBestPractices.*" />
  <Allowed From="FluentBitwarden.*" To="BitwardenApi.*" />
  <Allowed From="FluentBitwarden.*" To="FluentBitwarden.Platform.*" />
  <Allowed From="FluentBitwarden.*" To="FluentBitwarden.Contracts.*" />

  <!-- Application owns its implementation details and may compose Infrastructure services. -->
  <Allowed
    From="FluentBitwarden.AppHost.Application.*"
    To="FluentBitwarden.AppHost.Application.*" />

  <Allowed
    From="FluentBitwarden.AppHost.Application.*"
    To="FluentBitwarden.AppHost.Infrastructure.*" />

  <!-- Application-wide capabilities are available through abstractions only. -->
  <Allowed
    From="FluentBitwarden.AppHost.*"
    To="FluentBitwarden.AppHost.Application.Abstractions.*" />

  <!-- Infrastructure may use its own implementation details. -->
  <Allowed
    From="FluentBitwarden.AppHost.Infrastructure.*"
    To="FluentBitwarden.AppHost.Infrastructure.*" />

  <Allowed
    From="FluentBitwarden.AppHost.Infrastructure.Data.*"
    To="DbUp.*" />

  <!-- Feature modules may use shared AppHost infrastructure, but not the reverse. -->
  <Allowed
    From="FluentBitwarden.AppHost.Modules.*"
    To="FluentBitwarden.AppHost.Infrastructure.*" />

  <Disallowed
    From="FluentBitwarden.AppHost.Modules.*"
    To="FluentBitwarden.AppHost.Infrastructure.Data.Implementations.*" />

  <!-- A module may reference its own implementation namespaces. -->
  <Allowed
    From="FluentBitwarden.AppHost.Modules.[Module].*"
    To="FluentBitwarden.AppHost.Modules.[Module].*" />

  <!-- Module registration composes the implementations into the host. -->
  <Allowed
    From="FluentBitwarden.AppHost.Modules"
    To="FluentBitwarden.AppHost.Modules.*" />

  <!-- Code outside a module may depend on that module only through Contracts. -->
  <Allowed
    From="FluentBitwarden.AppHost.*"
    To="FluentBitwarden.AppHost.Modules.*.Contracts.*" />

  <!-- AppSession follows the same internal/Contracts boundary as a feature module. -->
  <Allowed
    From="FluentBitwarden.AppHost.AppSession.*"
    To="FluentBitwarden.AppHost.AppSession.*" />

  <Allowed
    From="FluentBitwarden.AppHost.*"
    To="FluentBitwarden.AppHost.AppSession.Contracts.*" />


  <!-- The composition root and lifecycle coordinator compose Application and Infrastructure services. -->
  <Allowed
    From="FluentBitwarden.AppHost"
    To="FluentBitwarden.AppHost.Application" />

  <Allowed
    From="FluentBitwarden.AppHost"
    To="FluentBitwarden.AppHost.Application.Activation" />

  <Allowed
    From="FluentBitwarden.AppHost"
    To="FluentBitwarden.AppHost.Infrastructure" />

  <Allowed
    From="FluentBitwarden.AppHost"
    To="FluentBitwarden.AppHost.Infrastructure.Data.Abstractions" />

  <Allowed
    From="FluentBitwarden.AppHost"
    To="FluentBitwarden.AppHost.Infrastructure.Processes" />

  <Allowed
    From="FluentBitwarden.AppHost"
    To="FluentBitwarden.AppHost.Infrastructure.Tray" />

  <Allowed
    From="FluentBitwarden.AppHost"
    To="FluentBitwarden.AppHost.Ipc" />

  <!-- IPC handlers may use the process and WebAuthn infrastructure they dispatch to. -->
  <Allowed
    From="FluentBitwarden.AppHost.Ipc"
    To="FluentBitwarden.AppHost.Infrastructure.Processes" />

  <Allowed
    From="FluentBitwarden.AppHost.Ipc"
    To="FluentBitwarden.AppHost.Infrastructure.WebAuthn" />

  <Allowed
    From="FluentBitwarden.AppHost"
    To="FluentBitwarden.AppHost.AppSession" />

  <Allowed
    From="FluentBitwarden.AppHost"
    To="FluentBitwarden.AppHost.Modules.Account" />

  <Allowed
    From="FluentBitwarden.AppHost"
    To="FluentBitwarden.AppHost.Modules.Vault" />

  <!-- SSH agent integration owns its internal protocol and service dependencies. -->
  <Allowed
    From="FluentBitwarden.AppHost.Integrations.SshAgent.*"
    To="FluentBitwarden.AppHost.Integrations.SshAgent.*" />

  <Allowed
    From="FluentBitwarden.AppHost.Integrations.SshAgent.*"
    To="FluentBitwarden.AppHost.Infrastructure.Processes.*" />

  <Allowed
    From="FluentBitwarden.AppHost.Integrations.SshAgent.*"
    To="Org.BouncyCastle.*" />

  <Allowed
    From="FluentBitwarden.AppHost"
    To="FluentBitwarden.AppHost.Integrations.SshAgent" />
  
</NsDepCopConfig>
