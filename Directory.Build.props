<Project>
  <PropertyGroup Label="Shared C# Build Settings" Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
	<IsAotCompatible>true</IsAotCompatible>
	<IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <PropertyGroup Label="Windows App Project Configurations" Condition="'$(MSBuildProjectExtension)' == '.csproj' and Exists('$(MSBuildProjectDirectory)\app.manifest')">
    <Configurations Condition="'$(Configurations)' == ''">Debug;Release</Configurations>
    <Platforms Condition="'$(Platforms)' == ''">x64;ARM64</Platforms>
  </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<PublishTrimmed>false</PublishTrimmed>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' != 'Debug'">
		<PublishTrimmed>true</PublishTrimmed>
		<ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
	</PropertyGroup>
</Project>
