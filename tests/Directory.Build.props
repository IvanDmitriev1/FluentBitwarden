<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />

  <PropertyGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <SelfContained>false</SelfContained>
    <PublishSelfContained>false</PublishSelfContained>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <CsWinRTAotOptimizerEnabled>false</CsWinRTAotOptimizerEnabled>
  </PropertyGroup>

  <ItemGroup Label="Shared Test Dependencies" Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup Label="Shared Test Usings" Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
