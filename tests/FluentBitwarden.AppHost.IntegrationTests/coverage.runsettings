<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*FluentBitwarden\.AppHost\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Exclude>
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
